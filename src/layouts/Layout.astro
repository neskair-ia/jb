---
import '../styles/global.css';
import { SITE, CONTACT } from '../config';
import AmbientLight from '../components/AmbientLight.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { 
	title = SITE.title, 
	description = SITE.description, 
	image = '/og-image.jpg' 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE.url);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<!-- Fonts (Inter) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="font-sans antialiased text-slate-800 bg-[#F8F9FA] min-h-screen overflow-x-hidden">
		
		<!-- Splash Screen (Pantalla de carga - Solo en Inicio) -->
		{isHome && (
			<div id="splash-screen" class="fixed inset-0 z-[9999] bg-[#1E2D64] flex items-center justify-center transition-opacity duration-500" oncontextmenu="return false;">
				<div class="relative w-full h-full md:w-4/5 md:h-4/5 flex items-center justify-center animate-pulse-glow">
					<img 
						id="splash-img"
						src="/hero-foto.png" 
						alt="JB Ingeniería Corporativa"
						class="w-full h-full object-contain pointer-events-none select-none mix-blend-screen contrast-125 brightness-110 drop-shadow-2xl"
						oncontextmenu="return false;"
					/>
				</div>
			</div>
		)}

		<AmbientLight />

		<!-- Barra de progreso de scroll animada (Barra lateral celular/desktop) -->
		<div id="scroll-progress-container" class="fixed top-0 right-0 h-screen w-1 md:w-1.5 bg-[#0f172a]/40 z-[9999] overflow-hidden">
			<div id="scroll-progress-bar" class="w-full h-0 bg-gradient-to-b from-[#60a5fa] to-[#2563eb] shadow-[0_0_10px_#60a5fa] rounded-b-full transition-[height] duration-75 ease-out"></div>
		</div>

		<slot />

		<!-- Floating WhatsApp Button Container -->
		<div class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
			
			<!-- Tooltip animado -->
			<div 
				id="wa-tooltip" 
				class="secure-contact-btn hidden sm:flex flex-col opacity-0 translate-x-4 transition-all duration-500 bg-white text-slate-800 py-3 px-4 rounded-2xl shadow-[0_15px_30px_-5px_rgba(0,0,0,0.2)] border border-slate-100/50 cursor-pointer hover:bg-slate-50 pointer-events-none group"
				data-type="whatsapp"
				data-target={CONTACT.whatsapp}
			>
				<span class="text-[13px] font-bold text-[#1E2D64] mb-0.5">¿Te ayudamos con tu proyecto?</span>
				<span class="text-[11px] text-slate-500 font-medium group-hover:text-slate-800 transition-colors">Solicitá tu cotización hoy mismo. ¡Hablemos!</span>
			</div>

			<!-- Botón -->
			<button 
				class="secure-contact-btn flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] text-[#FFFCFC] shadow-xl shadow-[#25D366]/30 hover:scale-110 transition-transform duration-300 shrink-0"
				data-type="whatsapp"
				data-target={CONTACT.whatsapp}
				aria-label="Contactar por WhatsApp"
			>
				<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
				</svg>
			</button>
		</div>

		<script>
			// Lógica Anti-Spam global y Pantalla de Carga
			document.addEventListener('DOMContentLoaded', () => {
				
				// Lógica de la pantalla de carga (Splash Screen)
				const splashScreen = document.getElementById('splash-screen');
				const splashImg = document.getElementById('splash-img');
				
				if (splashScreen && splashImg) {
					// Evitar scroll temporalmente
					document.body.style.overflow = 'hidden';
					
					let hasFaded = false;
					const hideSplash = () => {
						if (hasFaded) return;
						hasFaded = true;
						splashScreen.style.opacity = '0';
						splashScreen.style.pointerEvents = 'none';
						document.body.style.overflow = '';
						setTimeout(() => {
							splashScreen.remove();
						}, 500); // Dar tiempo a que termine la transición de opacidad
					};

					// Tiempo reducido para una carga más rápida
					setTimeout(hideSplash, 800);
				}

				// Lógica Anti-Spam
				const buttons = document.querySelectorAll('.secure-contact-btn');
				buttons.forEach(btn => {
					btn.addEventListener('click', (e) => {
						const targetBtn = e.currentTarget as HTMLButtonElement;
						const type = targetBtn.dataset.type;
						const base64Data = targetBtn.dataset.target;
						
						if (base64Data) {
							try {
								const decoded = atob(base64Data);
								if (type === 'email') window.location.href = `mailto:${decoded}`;
								else if (type === 'tel') window.location.href = `tel:${decoded}`;
								else if (type === 'whatsapp') window.open(`https://wa.me/${decoded}`, '_blank');
							} catch (error) {
								console.error('Error al procesar el contacto seguro.');
							}
						}
					});
				});

				// Observer for scroll animations removed per user request

				// Lógica del Tooltip de WhatsApp
				const tooltip = document.getElementById('wa-tooltip');
				if (tooltip) {
					// Función para mostrar el tooltip
					const showTooltip = () => {
						tooltip.classList.remove('opacity-0', 'translate-x-4', 'pointer-events-none');
						tooltip.classList.add('opacity-100', 'translate-x-0', 'pointer-events-auto');
						
						// Ocultar automáticamente después de 6 segundos
						setTimeout(() => {
							tooltip.classList.remove('opacity-100', 'translate-x-0', 'pointer-events-auto');
							tooltip.classList.add('opacity-0', 'translate-x-4', 'pointer-events-none');
						}, 6000);
					};

					// Mostrarlo la primera vez a los 10 segundos
					setTimeout(() => {
						showTooltip();
						// Luego repetir cada 30 segundos
						setInterval(showTooltip, 30000);
					}, 10000);
				}

				// Prevención infalible de arrastre de imágenes y enlaces (Global)
				document.addEventListener('dragstart', (e) => {
					if (e.target && (e.target.nodeName === 'IMG' || e.target.nodeName === 'A')) {
						e.preventDefault();
					}
				});
				
				// Deshabilitar menú contextual en imágenes
				document.addEventListener('contextmenu', (e) => {
					if (e.target && e.target.nodeName === 'IMG') {
						e.preventDefault();
					}
				});

				// Lógica para la barra de progreso de scroll animada (especialmente para celular)
				const scrollProgressBar = document.getElementById('scroll-progress-bar');
				if (scrollProgressBar) {
					const updateScroll = () => {
						const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
						// Evitar división por cero
						if (scrollTotal <= 0) return; 
						const scrollProgress = (window.scrollY / scrollTotal) * 100;
						scrollProgressBar.style.height = `${scrollProgress}%`;
					};
					window.addEventListener('scroll', updateScroll, { passive: true });
					// Inicializar
					updateScroll();
				}
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--font-fallback: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
	}
	html {
		font-family: 'Inter', var(--font-fallback);
		scrollbar-width: thin;
		scrollbar-color: #3b82f6 #1E2D64;
	}

	/* Scrollbar súper profesional y moderno para navegadores Webkit (Chrome, Safari, Edge) */
	::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	::-webkit-scrollbar-track {
		background: #0f172a; 
	}
	::-webkit-scrollbar-thumb {
		background: linear-gradient(180deg, #60a5fa, #2563eb);
		border-radius: 10px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: linear-gradient(180deg, #93c5fd, #3b82f6);
	}

	/* En celulares ocultamos la barra nativa para que solo se vea la barra animada de progreso */
	@media (max-width: 768px) {
		::-webkit-scrollbar {
			display: none;
		}
		html {
			scrollbar-width: none;
		}
	}

	/* Evitar que las fotos y carruseles se puedan arrastrar con el mouse */
	img {
		-webkit-user-drag: none;
		user-drag: none;
		-webkit-user-select: none;
		-moz-user-select: none;
		-ms-user-select: none;
		user-select: none;
		pointer-events: none;
	}
	
	/* Solo permitimos pointer-events en elementos clickeables que puedan contener imagenes */
	a img, button img, .cursor-pointer img {
		pointer-events: auto;
	}
	
	/* Animaciones de scroll desactivadas */
	.animate-on-scroll {
		opacity: 1;
		transform: translateY(0);
	}
	.animate-on-scroll.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Animación épica de brillo (Glow) para la pantalla de carga (Optimizada por hardware) */
	@keyframes pulse-glow {
		0%, 100% {
			transform: scale(0.98);
			opacity: 0.9;
		}
		50% {
			transform: scale(1.04);
			opacity: 1;
		}
	}
	.animate-pulse-glow {
		animation: pulse-glow 2.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}
</style>
