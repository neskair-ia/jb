---
import { CONTACT } from '../config';
const currentPath = Astro.url.pathname;

const getLinkClass = (path: string, isMobile: boolean = false) => {
  const isActive = currentPath === path || currentPath === path + '/';
  
  if (isMobile) {
    const baseMobileClass = `text-[15px] font-bold transition-all duration-300 relative px-5 py-3.5 rounded-2xl w-full flex items-center justify-between border backdrop-blur-md`;
    if (isActive) {
      return `${baseMobileClass} text-[#FFFCFC] bg-blue-500/20 border-blue-400/40 shadow-[0_0_15px_rgba(59,130,246,0.2)]`;
    }
    return `${baseMobileClass} text-[#FFFCFC]/90 bg-[#FFFCFC]/5 border-[#FFFCFC]/10 hover:bg-[#FFFCFC]/15 hover:text-[#FFFCFC] hover:border-[#FFFCFC]/30`;
  }

  const baseClass = `text-sm font-medium transition-all duration-300 relative px-4 py-2 rounded-full`;
  if (isActive) {
    return `${baseClass} text-[#FFFCFC] bg-[#FFFCFC]/10 shadow-[0_0_20px_rgba(255,252,252,0.2)] border border-[#FFFCFC]/20`;
  }
  return `${baseClass} text-[#FFFCFC]/70 hover:text-[#FFFCFC] hover:bg-[#FFFCFC]/10 hover:-translate-y-[2px] hover:shadow-[0_0_15px_rgba(255,252,252,0.2)]`;
};

const mobileMenuLinks = [
  { name: 'Inicio', path: '/' },
  { name: 'Nosotros', path: '/nosotros' },
  { name: 'Servicios', path: '/servicios' },
  { name: 'Infraestructura', path: '/infraestructura' },
  { name: 'Proyectos', path: '/proyectos' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-b from-[#1E2D64] via-[#1E2D64] to-transparent pb-8 transition-all duration-300 pointer-events-none">
  <div class="container mx-auto px-4 pointer-events-auto mt-2">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <img 
          src="/images/logo.png" 
          alt="JB Logo" 
          class="w-20 h-20 sm:w-32 sm:h-32 object-contain transition-all duration-300 group-hover:scale-105 group-hover:drop-shadow-[0_0_15px_#FFFCFC]"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <!-- Fallback si la imagen no existe aún -->
        <div class="hidden w-12 h-12 text-[#FFFCFC] border-2 border-[#FFFCFC] rounded-lg items-center justify-center font-bold text-xl transition-colors group-hover:text-blue-400 group-hover:border-blue-400">
          JB
        </div>
        <span class="font-bold text-xl text-[#FFFCFC] hidden sm:block">
          Ingeniería Corporativa
        </span>
      </a>

      <!-- Desktop Menu -->
      <nav class="hidden md:flex items-center gap-2">
        <a href="/" class={getLinkClass('/')}>Inicio</a>
        <a href="/nosotros" class={getLinkClass('/nosotros')}>Nosotros</a>
        <a href="/servicios" class={getLinkClass('/servicios')}>Servicios</a>
        <a href="/infraestructura" class={getLinkClass('/infraestructura')}>Infraestructura</a>
        <a href="/proyectos" class={getLinkClass('/proyectos')}>Proyectos</a>
      </nav>

      <!-- Contact Buttons -->
      <div class="flex items-center gap-2 sm:gap-4">
        <button 
          class="secure-contact-btn hidden lg:flex items-center gap-2 px-4 py-2 rounded-full border border-[#FFFCFC]/20 text-sm font-medium text-[#FFFCFC] hover:bg-transparent/10 transition-colors"
          data-type="tel"
          data-target={CONTACT.phoneBase64}
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Llamar
        </button>
        <button 
          class="secure-contact-btn flex items-center gap-2 px-3 py-2 sm:px-5 sm:py-2.5 rounded-full bg-[#FFFCFC] text-[#1E2D64] text-sm font-bold hover:scale-105 hover:shadow-[0_0_20px_rgba(255,252,252,0.4)] transition-all duration-300 shadow-lg shadow-[#FFFCFC]/10"
          data-type="whatsapp"
          data-target={CONTACT.whatsapp}
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="hidden sm:inline">WhatsApp</span>
        </button>

        <!-- Mobile Menu Toggle Button (Con dot que insita al clic) -->
        <button 
          id="mobile-menu-toggle"
          class="md:hidden relative flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-blue-500/90 text-[#FFFCFC] hover:bg-blue-400 transition-all duration-300 ml-1 shadow-[0_0_15px_rgba(59,130,246,0.4)] border border-blue-400/50 backdrop-blur-sm"
          aria-label="Menú"
        >
          <!-- Punto rojo pulsante para atraer la atención -->
          <span class="absolute -top-1 -right-1 flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500 border border-[#1E2D64]"></span>
          </span>
          
          <span class="text-[11px] font-bold uppercase tracking-wider">Menú</span>
          <div class="relative w-5 h-5">
            <svg id="icon-menu" class="absolute inset-0 w-full h-full transition-opacity duration-300 opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" class="absolute inset-0 w-full h-full transition-opacity duration-300 opacity-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
        </button>
      </div>

    </div>
    
    <!-- Mobile Menu Container (Animado de forma fluida con grid-rows) -->
    <div 
      id="mobile-menu" 
      class="md:hidden grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-out"
    >
      <div class="overflow-hidden">
        <nav class="flex flex-col gap-3 px-1 pb-6 pt-3 mt-3 border-t border-[#FFFCFC]/10">
          {mobileMenuLinks.map(link => (
            <a href={link.path} class={getLinkClass(link.path, true)}>
              <span class="tracking-wide">{link.name}</span>
              <svg class="w-4 h-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (toggleBtn && mobileMenu && iconMenu && iconClose) {
    toggleBtn.addEventListener('click', () => {
      // Toggle de menú con animación fluida de altura
      const isClosed = mobileMenu.classList.contains('grid-rows-[0fr]');
      
      if (isClosed) {
        mobileMenu.classList.replace('grid-rows-[0fr]', 'grid-rows-[1fr]');
        mobileMenu.classList.replace('opacity-0', 'opacity-100');
        iconMenu.classList.replace('opacity-100', 'opacity-0');
        iconClose.classList.replace('opacity-0', 'opacity-100');
        
        // Al abrir por primera vez, si queremos podríamos ocultar el puntito rojo
        const dot = toggleBtn.querySelector('.animate-ping');
        if (dot) dot.parentElement?.remove();
      } else {
        mobileMenu.classList.replace('grid-rows-[1fr]', 'grid-rows-[0fr]');
        mobileMenu.classList.replace('opacity-100', 'opacity-0');
        iconMenu.classList.replace('opacity-0', 'opacity-100');
        iconClose.classList.replace('opacity-100', 'opacity-0');
      }
    });
  }
</script>

