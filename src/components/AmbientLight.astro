---
// AmbientLight.astro
// Este componente agrega orbes de luz difuminada animados al fondo
// de la página, dándole un estilo premium y fluido de glassmorphism.
---

<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
  <!-- Orbe Superior Izquierdo (Azul) -->
  <div class="absolute -top-[10%] -left-[10%] w-[50vw] h-[50vw] min-w-[400px] min-h-[400px] rounded-full bg-blue-500/25 blur-[120px] mix-blend-screen animate-ambient-drift-1"></div>
  
  <!-- Orbe Central Derecho (Cyan) -->
  <div class="absolute top-[30%] -right-[15%] w-[40vw] h-[40vw] min-w-[300px] min-h-[300px] rounded-full bg-cyan-400/20 blur-[100px] mix-blend-screen animate-ambient-drift-2"></div>
  
  <!-- Orbe Inferior Izquierdo (Indigo) -->
  <div class="absolute -bottom-[20%] left-[10%] w-[55vw] h-[55vw] min-w-[450px] min-h-[450px] rounded-full bg-indigo-500/20 blur-[130px] mix-blend-screen animate-ambient-drift-3"></div>
</div>

<style>
  /* Animaciones fluidas, ahora con un poco más de movimiento y velocidad */
  @keyframes drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(15%, 20%) scale(1.1); }
    66% { transform: translate(-10%, 15%) scale(0.9); }
  }
  @keyframes drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-20%, -15%) scale(0.9); }
    66% { transform: translate(15%, -20%) scale(1.1); }
  }
  @keyframes drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(20%, -20%) scale(1.15); }
    66% { transform: translate(-15%, 20%) scale(0.85); }
  }
  
  .animate-ambient-drift-1 { animation: drift-1 15s infinite ease-in-out; }
  .animate-ambient-drift-2 { animation: drift-2 18s infinite ease-in-out reverse; }
  .animate-ambient-drift-3 { animation: drift-3 16s infinite ease-in-out; }
</style>
