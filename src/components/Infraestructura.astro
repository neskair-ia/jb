---
import { INFRASTRUCTURE } from '../config';
---

<section id="infraestructura" class="py-24 bg-[#1E2D64] relative min-h-screen">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        Infraestructura y Capacidad
      </h2>
      <p class="text-lg text-[#FFFCFC]/80 leading-relaxed">
        Contamos con la tecnología, maquinaria y personal certificado para ejecutar proyectos de gran escala con precisión milimétrica.
      </p>
    </div>

    <!-- Image Cards Grid -->
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {INFRASTRUCTURE.map((item, index) => (
        <div class="animate-on-scroll group relative aspect-[4/3] sm:aspect-square lg:aspect-[4/3] rounded-[2rem] overflow-hidden bg-transparent border border-[#FFFCFC]/10 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.3)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_60px_-15px_rgba(0,0,0,0.5)] hover:border-[#FFFCFC]/30">
          <!-- Imagen de fondo (placeholder por ahora) -->
          <img 
            src={`https://placehold.co/800x600/1E2D64/FFFCFC?text=${item.title.split(' ').join('+')}`} 
            alt={item.title} 
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100" 
          />
          
          <!-- Gradiente oscuro para legibilidad -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#1E2D64] via-[#1E2D64]/60 to-transparent opacity-90 group-hover:opacity-80 transition-opacity duration-500"></div>
          
          <!-- Contenido -->
          <div class="absolute inset-0 p-6 flex flex-col justify-end">
            <h4 class="text-lg font-bold text-[#FFFCFC] mb-2 group-hover:text-blue-300 transition-colors leading-tight">{item.title}</h4>
            <p class="text-[#FFFCFC]/80 text-xs leading-relaxed line-clamp-3 group-hover:line-clamp-none transition-all duration-500">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
