---
import { INFRASTRUCTURE } from '../config';

const infraFiles = import.meta.glob('/public/infraestructura/*.{png,jpg,jpeg,webp,avif}');
// Mapeamos los archivos para tener un diccionario: { "1": "/infraestructura/1.jpg" }
const infraImages: Record<string, string> = {};
Object.keys(infraFiles).forEach(file => {
  // Extraer el nombre del archivo sin extensión (ej: "1", "2")
  const fileName = file.split('/').pop()?.split('.')[0];
  if (fileName) {
    infraImages[fileName] = file.replace('/public', '');
  }
});
---

<section id="infraestructura" class="py-24 bg-transparent relative min-h-screen">
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        Infraestructura y Capacidad
      </h2>
      <p class="text-lg text-[#FFFCFC]/80 leading-relaxed">
        Contamos con la tecnología, maquinaria y personal certificado para ejecutar proyectos de gran escala con precisión milimétrica.
      </p>
    </div>

    <!-- Image Cards Grid -->
    <div class="max-w-[95rem] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {INFRASTRUCTURE.map((item, index) => (
        <div class="group relative aspect-square sm:aspect-[4/3] lg:aspect-[4/3] rounded-[2rem] overflow-hidden bg-black/20 border border-[#FFFCFC]/10 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.3)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_60px_-15px_rgba(0,0,0,0.5)] hover:border-[#FFFCFC]/30 cursor-default">
          <!-- Imagen dinámica o placeholder -->
          <img 
            src={infraImages[item.id.toString()] || `https://placehold.co/800x600/1E2D64/FFFCFC?text=${item.title.split(' ').join('+')}`} 
            alt={item.title} 
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90 group-hover:opacity-100" 
          />
          
          <!-- Gradiente oscuro inferior corto para legibilidad del texto sin ensuciar la foto -->
          <div class="absolute bottom-0 left-0 right-0 h-[60%] bg-gradient-to-t from-[#0e1633] via-[#0e1633]/60 to-transparent pointer-events-none"></div>
          
          <!-- Contenido -->
          <div class="absolute inset-0 p-6 md:p-8 flex flex-col justify-end">
            <h4 class="text-2xl font-bold text-[#FFFCFC] mb-3 group-hover:text-blue-300 transition-colors leading-tight drop-shadow-md">{item.title}</h4>
            <p class="text-[#FFFCFC]/85 text-sm md:text-[15px] leading-relaxed font-light line-clamp-3 group-hover:line-clamp-none transition-all duration-500">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
