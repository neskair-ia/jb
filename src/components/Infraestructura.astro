---
import { INFRASTRUCTURE } from '../config';
---

<section id="infraestructura" class="py-24 bg-transparent relative">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        Infraestructura y Capacidad
      </h2>
      <p class="text-lg text-[#FFFCFC]/80 leading-relaxed">
        Contamos con la tecnología, maquinaria y personal certificado para ejecutar proyectos de gran escala con precisión milimétrica.
      </p>
    </div>

    <!-- Accordion Grid -->
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-4">
      {INFRASTRUCTURE.map((item, index) => (
        <details class="animate-on-scroll group bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-[#FFFCFC]">
            {item.title}
            <span class="relative flex shrink-0 items-center justify-center w-6 h-6 transition duration-300 group-open:-rotate-180">
              <svg class="w-5 h-5 text-[#FFFCFC]/60 group-hover:text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-[#FFFCFC]/80 text-sm leading-relaxed border-t border-[#FFFCFC]/10 pt-4">
            {item.description}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details > summary {
    list-style: none;
  }
  details[open] summary ~ * {
    animation: sweep .5s ease-in-out;
  }
  @keyframes sweep {
    0%    {opacity: 0; transform: translateY(-10px)}
    100%  {opacity: 1; transform: translateY(0)}
  }
</style>
