---
import { INFRASTRUCTURE } from '../config';

const infraFiles = import.meta.glob('/public/infraestructura/*.{png,jpg,jpeg,webp,avif}');
// Mapeamos los archivos para tener un diccionario: { "1": "/infraestructura/1.jpg" }
const infraImages: Record<string, string> = {};
Object.keys(infraFiles).forEach(file => {
  // Extraer el nombre del archivo sin extensión (ej: "1", "2")
  const fileName = file.split('/').pop()?.split('.')[0];
  if (fileName) {
    infraImages[fileName] = file.replace('/public', '');
  }
});
---

<section id="infraestructura" class="pt-28 pb-16 md:py-24 bg-transparent relative overflow-hidden">
  <div class="max-w-[95rem] mx-auto px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4 text-[#FFFCFC]">
        Nuestra Infraestructura
      </h2>
      <p class="text-base md:text-lg text-[#FFFCFC]/80 leading-relaxed font-light">
        Contamos con dos plantas de primer nivel para llevar a cabo cada etapa del desarrollo de los productos solicitados.
      </p>
    </div>

    <!-- Grid Layout ajustado para ocupar el ancho disponible -->
    <div class="grid grid-cols-2 md:grid-cols-2 xl:grid-cols-3 gap-3 md:gap-12">
      {INFRASTRUCTURE.map((item, index) => (
        <div class="group flex flex-col gap-5 cursor-default">
          <!-- Contenedor de Imagen -->
          <div class="relative w-full aspect-[4/3] rounded-[2rem] overflow-hidden bg-black/20 border border-[#FFFCFC]/10 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.3)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_60px_-15px_rgba(0,0,0,0.5)]">
            <!-- Imagen dinámica o placeholder -->
            <img 
              src={infraImages[item.id.toString()] || `https://placehold.co/800x600/1E2D64/FFFCFC?text=${item.title.split(' ').join('+')}`} 
              alt={item.title} 
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-100" 
            />
          </div>
          
          <!-- Contenido de Texto (Limpio y fuera de la foto) -->
          <div class="flex flex-col px-1 md:px-2">
            <h3 class="text-sm sm:text-base md:text-2xl font-bold text-[#FFFCFC] mb-1 md:mb-2 group-hover:text-blue-300 transition-colors leading-tight">
              {item.title}
            </h3>
            
            {["Pintura Electrostática Secada en Horno", "Equipo de Trabajo", "Desarrollos Especiales", "Capacidades", "Ensayo No Destructivo", "Pruebas de Tintas Penetrantes"].includes(item.title) ? (
              <>
                <!-- Lógica CSS-only para "Seguir leyendo" -->
                <input type="checkbox" id={`infra-${index}`} class="peer hidden" />
                <p class="text-[#FFFCFC]/70 text-xs sm:text-sm md:text-[15px] leading-relaxed font-light line-clamp-3 peer-checked:line-clamp-none transition-all duration-300">
                  {item.description}
                </p>
                <div class="mt-2 flex peer-checked:hidden">
                  <label for={`infra-${index}`} class="inline-flex items-center justify-center px-3 py-1 rounded-full border border-blue-400 text-blue-400 text-[10px] sm:text-xs cursor-pointer font-bold hover:bg-blue-400 hover:text-[#1E2D64] transition-colors select-none shadow-[0_0_10px_rgba(96,165,250,0.1)]">
                    Seguir leyendo
                  </label>
                </div>
              </>
            ) : (
              <p class="text-[#FFFCFC]/70 text-xs sm:text-sm md:text-[15px] leading-relaxed font-light transition-all duration-300">
                {item.description}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
