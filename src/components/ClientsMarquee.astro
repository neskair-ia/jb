---
const clientFiles = import.meta.glob('/public/clientes/*.{png,jpg,jpeg,svg,webp}');
// Convertimos la ruta del proyecto (ej: /public/clientes/afip.jpg) a ruta web (ej: /clientes/afip.jpg)
const clientLogos = Object.keys(clientFiles).map(file => file.replace('/public', ''));

// Fallback por si no se detectan imágenes
const displayLogos = clientLogos.length > 0 ? clientLogos : ['/images/logo.png'];
---

<section class="py-6 bg-[#FFFCFC]/5 border-t border-b border-[#FFFCFC]/10 overflow-hidden relative backdrop-blur-sm z-10 mt-8 mb-16">
  <div class="container mx-auto px-4 mb-8">
    <h3 class="text-center text-[#FFFCFC]/60 text-xs md:text-sm uppercase tracking-[0.2em] font-bold">
      Algunas de las empresas que confían en nosotros
    </h3>
  </div>
  
  <div class="flex overflow-hidden w-full">
    <div class="flex w-max whitespace-nowrap animate-marquee-fast shrink-0">
      {displayLogos.map((logoPath) => (
        <div class="mx-3 sm:mx-6 md:mx-10 flex items-center justify-center w-28 h-16 sm:w-32 sm:h-20 md:w-40 md:h-24 bg-[#FFFCFC] p-2 md:p-4 rounded-lg md:rounded-xl shrink-0 group cursor-default hover:-translate-y-2 hover:shadow-[0_10px_20px_rgba(255,255,255,0.2)] transition-all duration-300">
          <img 
            src={logoPath} 
            alt="Logo Cliente" 
            class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110 rounded-sm md:rounded-md"
          />
        </div>
      ))}
    </div>
    <div class="flex w-max whitespace-nowrap animate-marquee-fast shrink-0">
      {displayLogos.map((logoPath) => (
        <div class="mx-3 sm:mx-6 md:mx-10 flex items-center justify-center w-28 h-16 sm:w-32 sm:h-20 md:w-40 md:h-24 bg-[#FFFCFC] p-2 md:p-4 rounded-lg md:rounded-xl shrink-0 group cursor-default hover:-translate-y-2 hover:shadow-[0_10px_20px_rgba(255,255,255,0.2)] transition-all duration-300">
          <img 
            src={logoPath} 
            alt="Logo Cliente" 
            class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110 rounded-sm md:rounded-md"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .animate-marquee-fast {
    animation: marquee-fast 50s linear infinite;
  }
  .animate-marquee-fast:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-fast {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-100%); }
  }
</style>
