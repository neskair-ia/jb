---
const clientFiles = import.meta.glob('/public/clientes/*.{png,jpg,jpeg,svg,webp}');
// Convertimos la ruta del proyecto (ej: /public/clientes/afip.jpg) a ruta web (ej: /clientes/afip.jpg)
const clientLogos = Object.keys(clientFiles).map(file => file.replace('/public', ''));

// Fallback por si no se detectan imágenes
const displayLogos = clientLogos.length > 0 ? clientLogos : ['/images/logo.png'];
---

<section class="py-6 bg-[#FFFCFC]/5 border-t border-b border-[#FFFCFC]/10 overflow-hidden relative backdrop-blur-sm z-10 mt-8 mb-16">
  <div class="container mx-auto px-4 mb-8">
    <h3 class="text-center text-[#FFFCFC]/60 text-xs md:text-sm uppercase tracking-[0.2em] font-bold">
      Algunas de las empresas que confían en nosotros
    </h3>
  </div>
  
  <div class="relative w-full flex whitespace-nowrap animate-marquee-fast">
    <!-- Triplicamos el array para asegurar un scroll infinito fluido sin cortes -->
    {[...displayLogos, ...displayLogos, ...displayLogos, ...displayLogos].map((logoPath) => (
      <div class="mx-6 md:mx-10 flex items-center justify-center w-24 h-10 md:w-32 md:h-14 bg-[#FFFCFC] p-2 rounded-xl shrink-0 group cursor-default hover:-translate-y-2 hover:shadow-[0_10px_20px_rgba(255,255,255,0.2)] transition-all duration-300">
        <img 
          src={logoPath} 
          alt={`Logo Cliente`} 
          class="max-w-full max-h-full object-contain transition-transform duration-300 group-hover:scale-110 rounded-md"
        />
      </div>
    ))}
  </div>
</section>

<style>
  .animate-marquee-fast {
    /* Rotación aún más rápida (10s) */
    animation: marquee-fast 10s linear infinite;
  }
  .animate-marquee-fast:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-fast {
    0% { transform: translateX(0%); }
    /* Como cuadruplicamos el array, trasladamos un 25% para el loop perfecto */
    100% { transform: translateX(-25%); }
  }
</style>
