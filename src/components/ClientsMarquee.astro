---
import { Image } from 'astro:assets';

// Auto-descubrir las imágenes de los clientes usando astro:assets
const clientFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/clientes/*.{png,jpg,jpeg,svg,webp}', { eager: true });
const clientLogos = Object.values(clientFiles).map(module => module.default);

// Fallback por si no hay imágenes o la carpeta no se encuentra
const displayLogos = clientLogos.length > 0 ? clientLogos : ['/images/logo.svg'];

// Duplicamos para asegurar que el marquee sea siempre infinito sin cortes
const infiniteLogos = [...displayLogos, ...displayLogos, ...displayLogos];
---

<section class="py-8 bg-gradient-to-b from-[#1E2D64] via-black/20 to-[#1E2D64] overflow-hidden relative z-10 mt-8 mb-16">
  <!-- Línea superior metálica -->
  <div class="metallic-hairline absolute top-0 left-0 right-0"></div>

  <div class="container mx-auto px-4 mb-8">
    <h3 class="text-center text-[#FFFCFC]/70 text-xs md:text-sm uppercase tracking-[0.25em] font-semibold">
      Algunas de las empresas que confían en nosotros
    </h3>
  </div>
  
  <div class="marquee-wrapper-fast flex overflow-hidden w-full py-4">
    <div class="flex w-max whitespace-nowrap animate-marquee-fast shrink-0 items-center">
      {infiniteLogos.map((logoPath) => (
        <div class="mx-3 sm:mx-6 md:mx-10 flex items-center justify-center w-28 h-16 sm:w-32 sm:h-20 md:w-40 md:h-24 bg-[#FFFCFC] p-2 md:p-4 rounded-xl shrink-0 cursor-default border border-slate-200/90 shadow-[inset_0_1px_1px_#ffffff,0_4px_14px_rgba(0,0,0,0.25)] hover:scale-105 hover:shadow-[0_12px_24px_rgba(0,0,0,0.35),0_0_15px_rgba(255,255,255,0.3)] transition-all duration-300">
          {typeof logoPath === 'string' ? (
            <img src={logoPath} alt="Logo Cliente" class="w-full h-full object-contain rounded-md" />
          ) : (
            <Image src={logoPath} alt="Logo Cliente" width={200} class="w-full h-full object-contain rounded-md" />
          )}
        </div>
      ))}
    </div>
    <div class="flex w-max whitespace-nowrap animate-marquee-fast shrink-0 items-center">
      {infiniteLogos.map((logoPath) => (
        <div class="mx-3 sm:mx-6 md:mx-10 flex items-center justify-center w-28 h-16 sm:w-32 sm:h-20 md:w-40 md:h-24 bg-[#FFFCFC] p-2 md:p-4 rounded-xl shrink-0 cursor-default border border-slate-200/90 shadow-[inset_0_1px_1px_#ffffff,0_4px_14px_rgba(0,0,0,0.25)] hover:scale-105 hover:shadow-[0_12px_24px_rgba(0,0,0,0.35),0_0_15px_rgba(255,255,255,0.3)] transition-all duration-300">
          {typeof logoPath === 'string' ? (
            <img src={logoPath} alt="Logo Cliente" class="w-full h-full object-contain rounded-md" />
          ) : (
            <Image src={logoPath} alt="Logo Cliente" width={200} class="w-full h-full object-contain rounded-md" />
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Línea inferior metálica -->
  <div class="metallic-hairline absolute bottom-0 left-0 right-0"></div>
</section>

<style>
  .animate-marquee-fast {
    animation: marquee-fast 300s linear infinite;
  }
  .marquee-wrapper-fast:hover .animate-marquee-fast {
    animation-play-state: paused;
  }
  @keyframes marquee-fast {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-100%); }
  }
</style>
