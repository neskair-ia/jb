---
import { PROJECTS_INTRO } from '../config';

const clientFiles = import.meta.glob('/public/clientes/*.{png,jpg,jpeg,svg,webp}');
const clientLogos = Object.keys(clientFiles).map(file => file.replace('/public', ''));

// Fallback por si no se detectan imágenes
const displayLogos = clientLogos.length > 0 ? clientLogos : ['/images/logo.png'];
---

<section id="proyectos" class="py-24 bg-transparent relative border-t border-[#FFFCFC]/10 min-h-screen">
  <div class="container mx-auto px-4 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        Trabajos que hablan por sí solos
      </h2>
      <p class="text-lg text-[#FFFCFC]/80 leading-relaxed font-light">
        {PROJECTS_INTRO}
      </p>
    </div>

    <!-- Carrusel de Logos de Clientes -->
    <div class="relative w-full overflow-hidden bg-[#FFFCFC]/5 backdrop-blur-md py-8 rounded-[2rem] shadow-[0_20px_50px_-15px_rgba(0,0,0,0.5)] border border-[#FFFCFC]/10 mb-20">
      <div class="flex whitespace-nowrap animate-marquee">
        <!-- Double the array for seamless infinite scroll -->
        {[...displayLogos, ...displayLogos, ...displayLogos, ...displayLogos].map((logoPath) => (
          <div class="mx-6 md:mx-8 flex items-center justify-center w-28 h-14 md:w-40 md:h-20 bg-[#FFFCFC] rounded-xl cursor-default group p-2 shrink-0">
            <img 
              src={logoPath} 
              alt="Cliente" 
              class="max-w-full max-h-full object-contain grayscale opacity-60 transition-all duration-300 group-hover:opacity-100 group-hover:grayscale-0 group-hover:scale-110 drop-shadow-md"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Galería de Proyectos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {Array.from({ length: 15 }).map((_, index) => (
        <div class="group relative aspect-[4/3] md:aspect-video bg-black/20 rounded-3xl overflow-hidden border border-[#FFFCFC]/10 shadow-lg hover:shadow-[0_20px_50px_-15px_rgba(0,0,0,0.5)] hover:border-blue-400/50 hover:-translate-y-2 transition-all duration-300 cursor-pointer project-card" style={`transition-delay: ${(index % 3) * 100}ms`}>
          
          <!-- Contenedor de 4 fotos interactivas -->
          <div class="absolute inset-0 w-full h-full rotate-slider">
            <img src={`https://placehold.co/600x400/1E2D64/FFFCFC?text=Foto+1+Proy+${index+1}`} class="slide-img opacity-100" alt="Foto 1" />
            <img src={`https://placehold.co/600x400/0e2146/FFFCFC?text=Foto+2+Proy+${index+1}`} class="slide-img opacity-0" alt="Foto 2" />
            <img src={`https://placehold.co/600x400/293b73/FFFCFC?text=Foto+3+Proy+${index+1}`} class="slide-img opacity-0" alt="Foto 3" />
            <img src={`https://placehold.co/600x400/394c85/FFFCFC?text=Foto+4+Proy+${index+1}`} class="slide-img opacity-0" alt="Foto 4" />
          </div>

          <!-- Gradiente inferior para legibilidad del título -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#1E2D64]/90 via-[#1E2D64]/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

          <!-- Título del Proyecto y Click Helper -->
          <div class="absolute bottom-0 left-0 right-0 p-6 flex flex-col justify-end pointer-events-none z-10">
            <h3 class="text-xl md:text-2xl font-bold text-[#FFFCFC] mb-2 drop-shadow-lg">
              Proyecto {index + 1}
            </h3>
            
            <!-- Helper visible en móvil, oculto y on-hover en PC -->
            <div class="flex items-center gap-2 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300 bg-[#1E2D64]/60 md:bg-transparent backdrop-blur-sm md:backdrop-blur-none py-1.5 px-3 md:p-0 rounded-full md:rounded-none w-fit border border-[#FFFCFC]/10 md:border-none">
              <svg class="w-4 h-4 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
              </svg>
              <span class="text-blue-300 text-[10px] md:text-xs uppercase tracking-wider font-bold drop-shadow-md">Toca para ver más</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Animación del carrusel de logos */
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  /* Estilos para las fotos interactivas */
  .rotate-slider {
    position: relative;
  }
  .rotate-slider .slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.6s ease-in-out;
  }
</style>

<script>
  // Script para manejar el clic en las tarjetas de proyectos
  document.addEventListener('DOMContentLoaded', () => {
    const projectCards = document.querySelectorAll('.project-card');
    
    projectCards.forEach(card => {
      // Estado local para cada tarjeta
      let currentIndex = 0;
      const images = card.querySelectorAll('.slide-img');
      const totalImages = images.length;
      
      card.addEventListener('click', () => {
        // Ocultar imagen actual
        images[currentIndex].classList.remove('opacity-100');
        images[currentIndex].classList.add('opacity-0');
        
        // Calcular siguiente índice
        currentIndex = (currentIndex + 1) % totalImages;
        
        // Mostrar siguiente imagen
        images[currentIndex].classList.remove('opacity-0');
        images[currentIndex].classList.add('opacity-100');
      });
    });
  });
</script>
