---
import { PROJECTS_INTRO, CLIENTS } from '../config';
---

<section id="proyectos" class="py-24 bg-transparent relative border-t border-slate-200">
  <div class="container mx-auto px-4">
    
    <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 text-[#1E2D64]">
        Trabajos que hablan por sí solos
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed">
        {PROJECTS_INTRO}
      </p>
    </div>

    <!-- Carrusel de Logos de Clientes (Infinite scroll animation) -->
    <!-- Contenedor oscuro para resaltar los logos blancos sobre la web clara -->
    <div class="relative w-full overflow-hidden bg-[#1E2D64] py-10 rounded-[2rem] shadow-xl border border-slate-200 mb-20 animate-on-scroll">
      <div class="flex whitespace-nowrap animate-marquee">
        {/* Double the array for seamless infinite scroll */}
        {[...CLIENTS, ...CLIENTS].map((client) => (
          <div class="mx-8 flex items-center justify-center w-40 h-20 bg-transparent rounded-xl cursor-default group">
            <img 
              src="/images/logo.png" 
              alt="Cliente" 
              class="max-w-full max-h-full object-contain opacity-70 transition-all duration-300 group-hover:opacity-100 group-hover:scale-110 drop-shadow-md"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Galería de Proyectos (15 Proyectos: 5 filas x 3 columnas) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {Array.from({ length: 15 }).map((_, index) => (
        <div class="animate-on-scroll group relative aspect-video bg-slate-900 rounded-3xl overflow-hidden border border-slate-200 shadow-md hover:shadow-2xl hover:border-blue-400 transition-all duration-300" style={`transition-delay: ${(index % 3) * 150}ms`}>
          
          <!-- Contenedor de 4 fotos rotativas (CSS puro) -->
          <div class="absolute inset-0 w-full h-full rotate-slider">
            <img src={`https://placehold.co/600x400/1E2D64/FFFCFC?text=Foto+1+Proy+${index+1}`} class="slide-img" alt="Foto 1" />
            <img src={`https://placehold.co/600x400/0e2146/FFFCFC?text=Foto+2+Proy+${index+1}`} class="slide-img" alt="Foto 2" />
            <img src={`https://placehold.co/600x400/293b73/FFFCFC?text=Foto+3+Proy+${index+1}`} class="slide-img" alt="Foto 3" />
            <img src={`https://placehold.co/600x400/394c85/FFFCFC?text=Foto+4+Proy+${index+1}`} class="slide-img" alt="Foto 4" />
          </div>

          <!-- Gradiente inferior para legibilidad del título -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#1E2D64]/90 via-[#1E2D64]/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

          <!-- Título del Proyecto -->
          <div class="absolute bottom-0 left-0 right-0 p-6 flex flex-col justify-end transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300 pointer-events-none">
            <h3 class="text-xl font-bold text-white mb-1 drop-shadow-md">
              Proyecto {index + 1}
            </h3>
            <span class="text-blue-200 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100 drop-shadow-sm">Ver detalles</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Animación del carrusel de logos */
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  /* Animación de 4 fotos rotativas (Fade) */
  .rotate-slider {
    position: relative;
  }
  .rotate-slider .slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: fadeSlider 16s infinite; /* 4 fotos * 4s = 16s totales */
  }
  /* Desfases para cada foto */
  .rotate-slider .slide-img:nth-child(1) { animation-delay: 0s; }
  .rotate-slider .slide-img:nth-child(2) { animation-delay: 4s; }
  .rotate-slider .slide-img:nth-child(3) { animation-delay: 8s; }
  .rotate-slider .slide-img:nth-child(4) { animation-delay: 12s; }

  @keyframes fadeSlider {
    0%, 20% { opacity: 1; }
    25%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }
</style>
