---
import { PROJECTS_INTRO, PROJECTS } from '../config';

const clientFiles = import.meta.glob('/public/clientes/*.{png,jpg,jpeg,svg,webp}');
const clientLogos = Object.keys(clientFiles).map(file => file.replace('/public', ''));

// Fallback por si no se detectan imágenes
const displayLogos = clientLogos.length > 0 ? clientLogos : ['/images/logo.png'];

// Auto-descubrir imágenes de los proyectos
const projectFiles = import.meta.glob('/public/proyectos/**/*.{png,jpg,jpeg,webp,avif}');
const projectImagesByFolder: Record<string, string[]> = {};

Object.keys(projectFiles).forEach(file => {
  // Extraer el número de carpeta (ej: /public/proyectos/1/foto.jpg -> "1")
  const match = file.match(/\/public\/proyectos\/(\d+)\//);
  if (match) {
    const folderId = match[1];
    if (!projectImagesByFolder[folderId]) projectImagesByFolder[folderId] = [];
    projectImagesByFolder[folderId].push(file.replace('/public', ''));
  }
});
---

<section id="proyectos" class="py-24 bg-transparent relative border-t border-[#FFFCFC]/10 min-h-screen">
  <div class="max-w-[95rem] mx-auto px-4 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        Trabajos que hablan por sí solos
      </h2>
      <p class="text-lg text-[#FFFCFC]/80 leading-relaxed font-light">
        {PROJECTS_INTRO}
      </p>
    </div>

    <!-- Carrusel de Logos de Clientes -->
    <div class="relative w-full overflow-hidden bg-[#FFFCFC]/5 backdrop-blur-md py-8 rounded-[2rem] shadow-[0_20px_50px_-15px_rgba(0,0,0,0.5)] border border-[#FFFCFC]/10 mb-20">
      <div class="flex w-max whitespace-nowrap animate-marquee">
        <!-- Double the array for seamless infinite scroll -->
        {[...displayLogos, ...displayLogos, ...displayLogos, ...displayLogos].map((logoPath) => (
          <div class="mx-6 md:mx-8 flex items-center justify-center w-28 h-14 md:w-40 md:h-20 bg-[#FFFCFC] rounded-xl cursor-default group p-2 shrink-0 hover:-translate-y-2 hover:shadow-[0_10px_20px_rgba(255,255,255,0.2)] transition-all duration-300">
            <img 
              src={logoPath} 
              alt="Cliente" 
              class="max-w-full max-h-full object-contain transition-transform duration-300 group-hover:scale-110 rounded-md"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Galería de Proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
      {PROJECTS.map((project, index) => {
        const projectId = (index + 1).toString();
        // Imágenes de la carpeta del proyecto actual
        const images = projectImagesByFolder[projectId] || [];
        
        // Si no hay imágenes en la carpeta, usamos 4 placeholders
        const displayImages = images.length > 0 
          ? images 
          : [
              `https://placehold.co/600x400/1E2D64/FFFCFC?text=Foto+1+Proy+${projectId}`,
              `https://placehold.co/600x400/0e2146/FFFCFC?text=Foto+2+Proy+${projectId}`,
              `https://placehold.co/600x400/293b73/FFFCFC?text=Foto+3+Proy+${projectId}`,
              `https://placehold.co/600x400/394c85/FFFCFC?text=Foto+4+Proy+${projectId}`
            ];

        return (
          <div class="group cursor-pointer project-card flex flex-col gap-5" style={`transition-delay: ${(index % 3) * 100}ms`}>
            
            <!-- Contenedor de fotos interactivas (Más alto y minimalista) -->
            <div class="relative w-full aspect-[3/4] md:aspect-[4/5] rounded-[2rem] overflow-hidden shadow-2xl transition-all duration-500 group-hover:-translate-y-3 group-hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.6)] bg-[#FFFCFC]/5">
              <div class="absolute inset-0 w-full h-full rotate-slider">
                {displayImages.map((imgSrc, imgIndex) => (
                  <img 
                    src={imgSrc} 
                    class={`slide-img transition-transform duration-700 group-hover:scale-105 ${imgIndex === 0 ? 'opacity-100' : 'opacity-0'}`} 
                    alt={`${project.title} - Foto ${imgIndex + 1}`} 
                  />
                ))}
              </div>
            </div>

            <!-- Título del Proyecto (Minimalista, debajo de la foto) -->
            <div class="flex flex-col px-2">
              <h3 class="text-2xl font-semibold text-[#FFFCFC] group-hover:text-blue-300 transition-colors">
                {project.title}
              </h3>
              
              <!-- Helper sutil -->
              {displayImages.length > 1 && (
                <div class="flex items-center gap-2 mt-2 opacity-60 group-hover:opacity-100 transition-opacity duration-300">
                  <svg class="w-4 h-4 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="text-[#FFFCFC] text-sm font-light tracking-wide">{displayImages.length} fotos - Toca la imagen para ver más</span>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  /* Animación del carrusel de logos */
  .animate-marquee {
    animation: marquee 120s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  /* Estilos para las fotos interactivas */
  .rotate-slider {
    position: relative;
  }
  .rotate-slider .slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.6s ease-in-out, transform 0.7s ease-out;
  }
</style>

<script>
  // Script para manejar el clic en las tarjetas de proyectos
  document.addEventListener('DOMContentLoaded', () => {
    const projectCards = document.querySelectorAll('.project-card');
    
    projectCards.forEach(card => {
      // Estado local para cada tarjeta
      let currentIndex = 0;
      const images = card.querySelectorAll('.slide-img');
      const totalImages = images.length;
      
      card.addEventListener('click', () => {
        // Ocultar imagen actual
        images[currentIndex].classList.remove('opacity-100');
        images[currentIndex].classList.add('opacity-0');
        
        // Calcular siguiente índice
        currentIndex = (currentIndex + 1) % totalImages;
        
        // Mostrar siguiente imagen
        images[currentIndex].classList.remove('opacity-0');
        images[currentIndex].classList.add('opacity-100');
      });
    });
  });
</script>
