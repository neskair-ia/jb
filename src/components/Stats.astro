---
const stats = [
  {
    number: 40,
    prefix: "Más de ",
    title: "Años de Experiencia",
    desc: "Trayectoria comprobada en el rubro."
  },
  {
    number: 200,
    prefix: "Más de ",
    title: "Proyectos Completados",
    desc: "Con empresas reconocidas y líderes del mercado."
  },
  {
    number: 100,
    prefix: "",
    suffix: "%",
    title: "Clientes Satisfechos",
    desc: "Las marcas más exigentes confían en nosotros proyecto a proyecto."
  },
  {
    number: 30,
    prefix: "Más de ",
    title: "Profesionales",
    desc: "Expertos dispuestos a entregar calidad en cada trabajo."
  }
];
---

<section class="relative z-10 mt-4 md:mt-16 px-4 container mx-auto mb-12 md:mb-20">
  <div class="metallic-titanium-panel rounded-3xl p-6 md:p-12 overflow-hidden">
    <!-- Línea de cromo pulido superior -->
    <div class="absolute top-0 left-0 right-0 h-[1.5px] bg-gradient-to-r from-transparent via-white/50 to-transparent pointer-events-none"></div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-12 relative z-10">
      
      {stats.map((stat, index) => (
        <div class="relative flex flex-col items-center md:items-start text-center md:text-left group p-2 md:p-4 md:-m-4 rounded-xl md:rounded-2xl hover:bg-white/[0.06] hover:-translate-y-1 md:hover:-translate-y-2 transition-all duration-300 cursor-default">
          
          <!-- Animated Number -->
          <div class="flex flex-col md:flex-row items-center md:items-baseline gap-0 md:gap-2 mb-2">
            {stat.prefix && (
              <span class="text-base sm:text-lg md:text-4xl font-bold text-slate-100 drop-shadow-[0_2px_4px_rgba(0,0,0,0.4)] whitespace-nowrap">
                {stat.prefix}
              </span>
            )}
            <div class="flex items-baseline gap-1">
              <span 
                class="stat-number metallic-text-steel text-4xl sm:text-5xl md:text-6xl font-black tracking-tighter"
                data-target={stat.number}
              >
                0
              </span>
              {stat.suffix && (
                <span class="text-2xl sm:text-3xl md:text-4xl font-bold text-blue-300 drop-shadow-[0_0_10px_rgba(147,197,253,0.5)]">
                  {stat.suffix}
                </span>
              )}
            </div>
          </div>

          <h3 class="text-[10px] sm:text-xs md:text-xl font-bold text-[#FFFCFC] mb-0.5 md:mb-3 group-hover:text-blue-300 transition-colors uppercase md:capitalize">
            {stat.title}
          </h3>

          <p class="hidden md:block text-[15px] text-[#FFFCFC]/70 font-light leading-relaxed max-w-[250px]">
            {stat.desc}
          </p>

          <!-- Divisor vertical metálico entre columnas en Desktop -->
          {index < 3 && (
            <div class="hidden md:block absolute -right-6 top-1/2 -translate-y-1/2 h-20 w-[1px] bg-gradient-to-b from-transparent via-white/20 to-transparent pointer-events-none"></div>
          )}

        </div>
      ))}

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const statsSection = document.querySelector('.stat-number')?.closest('section');
    if (!statsSection) return;

    let animated = false;

    const animateNumbers = () => {
      const statElements = document.querySelectorAll('.stat-number');
      
      statElements.forEach(el => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const duration = 2500; // 2.5 segundos de animación fluida
        const start = 0;
        let startTime: number | null = null;

        const easeOutExpo = (t: number) => t === 1 ? 1 : 1 - Math.pow(2, -10 * t);

        const animation = (currentTime: number) => {
          if (!startTime) startTime = currentTime;
          const timeElapsed = currentTime - startTime;
          const progress = Math.min(timeElapsed / duration, 1);
          
          const easeProgress = easeOutExpo(progress);
          const currentNumber = Math.floor(easeProgress * (target - start) + start);
          
          el.textContent = currentNumber.toString();

          if (progress < 1) {
            requestAnimationFrame(animation);
          } else {
            el.textContent = target.toString();
          }
        };

        requestAnimationFrame(animation);
      });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !animated) {
          animated = true;
          animateNumbers();
        }
      });
    }, { threshold: 0.2 });

    observer.observe(statsSection);
  });
</script>
