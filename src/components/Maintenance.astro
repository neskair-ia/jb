---
// Pantalla de suspensión temporal por falta de mantenimiento
import { CONTACT } from '../config';
---

<div class="min-h-screen w-full bg-gradient-to-br from-[#060B18] via-[#0E1A38] to-[#1E2D64] text-white flex flex-col items-center justify-between p-6 sm:p-10 relative overflow-hidden select-none">
  <!-- Efectos de luz de fondo sutiles -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/15 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-amber-500/10 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

  <!-- Header / Identidad -->
  <header class="w-full max-w-4xl flex items-center justify-between pt-2 pb-6 border-b border-white/10 relative z-10">
    <div class="flex items-center gap-3">
      <img 
        src="/images/logo.svg" 
        alt="JB Ingeniería Corporativa" 
        class="w-12 h-12 sm:w-14 sm:h-14 object-contain drop-shadow-[0_0_12px_rgba(255,255,255,0.3)] select-none pointer-events-none"
        onerror="this.src='/images/logo.png';"
      />
      <div class="flex flex-col">
        <span class="font-extrabold text-sm sm:text-base tracking-wider text-white">JB INGENIERÍA</span>
        <span class="text-[10px] tracking-widest text-slate-400 uppercase font-semibold">Corporativa S.R.L.</span>
      </div>
    </div>
    
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span>Servicio Inactivo</span>
    </div>
  </header>

  <!-- Contenido Central -->
  <main class="w-full max-w-2xl my-auto py-10 flex flex-col items-center text-center relative z-10">
    <!-- Ícono de alerta/mantenimiento con brillo -->
    <div class="relative mb-8">
      <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-gradient-to-b from-[#1b274c] to-[#0d162e] border border-amber-400/30 shadow-[0_0_50px_rgba(245,158,11,0.2)] flex items-center justify-center relative">
        <svg class="w-12 h-12 sm:w-14 sm:h-14 text-amber-400 drop-shadow-[0_2px_8px_rgba(245,158,11,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
        </svg>
      </div>
      <div class="absolute -bottom-2 -right-2 w-9 h-9 rounded-xl bg-slate-900 border border-slate-700 flex items-center justify-center text-slate-300 shadow-md">
        <svg class="w-5 h-5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.07a4.5 4.5 0 004.486-6.32l-3.27 3.27M9.25 8.75l-4.5 4.5" />
        </svg>
      </div>
    </div>

    <!-- Título Principal -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-4">
      Página no disponible por el momento
    </h1>

    <!-- Explicación requerida -->
    <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-xl mb-7">
      El acceso a este sitio web se encuentra temporalmente suspendido por <span class="text-amber-300 font-semibold">falta de mantenimiento</span> técnico y actualización administrativa de la plataforma.
    </p>

    <!-- Tarjeta de Detalles Técnicos / Administrativos -->
    <div class="w-full bg-slate-900/70 backdrop-blur-md rounded-2xl border border-white/10 p-5 sm:p-6 text-left shadow-2xl relative overflow-hidden mb-6">
      <div class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-amber-500 via-blue-500 to-indigo-500"></div>
      
      <div class="flex items-center gap-2 mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Detalle de estado</span>
      </div>

      <div class="space-y-2.5 text-sm text-slate-300">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2 border-b border-white/5 gap-1">
          <span class="text-slate-400">Estado:</span>
          <span class="font-mono text-amber-300 font-medium">503 - Suspensión Temporal</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2 border-b border-white/5 gap-1">
          <span class="text-slate-400">Motivo:</span>
          <span class="font-medium text-slate-200">Falta de mantenimiento y regularización de servicios</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 pt-1">
          <span class="text-slate-400">Información:</span>
          <span class="text-slate-300 text-xs sm:text-sm">Utilice las vías de contacto inferiores para consultar el estado.</span>
        </div>
      </div>
    </div>

    <!-- Canales de contacto para informar del estado de la página -->
    <div class="w-full flex flex-col gap-3">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center justify-center gap-2">
        <span>Canales de contacto y consulta sobre el estado</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 w-full">
        <!-- WhatsApp -->
        <a 
          href={`https://wa.me/5493814090229?text=${encodeURIComponent('Hola, deseo consultar sobre el estado y mantenimiento de la página web.')}`}
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-[#25D366]/15 hover:bg-[#25D366]/25 border border-[#25D366]/40 text-[#25D366] hover:text-white font-medium text-xs sm:text-[13px] transition-all duration-200 shadow-md group"
        >
          <svg class="w-4 h-4 text-[#25D366] group-hover:scale-110 transition-transform shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="truncate">WhatsApp: +54 9 381 409-0229</span>
        </a>

        <!-- Teléfono de guardia/llamada -->
        <a 
          href={`tel:${CONTACT.callRaw.replace(/\s+/g, '')}`}
          class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-blue-600/15 hover:bg-blue-600/25 border border-blue-400/30 text-blue-200 hover:text-white font-medium text-xs sm:text-[13px] transition-all duration-200 shadow-md group"
        >
          <svg class="w-4 h-4 text-blue-400 group-hover:scale-110 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="truncate">Llamar: {CONTACT.callRaw}</span>
        </a>

        <!-- Correo Electrónico -->
        <a 
          href={`mailto:${CONTACT.emailRaw}?subject=${encodeURIComponent('Consulta sobre estado de la página web')}`}
          class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-white/10 hover:bg-white/15 border border-white/20 text-slate-200 hover:text-white font-medium text-xs sm:text-[13px] transition-all duration-200 shadow-md group"
        >
          <svg class="w-4 h-4 text-blue-300 group-hover:scale-110 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="truncate">{CONTACT.emailRaw}</span>
        </a>
      </div>
    </div>

    <!-- Mensaje secundario de cortesía -->
    <p class="mt-7 text-xs text-slate-400 max-w-md">
      Lamentamos los inconvenientes ocasionados. La disponibilidad del servicio se restablecerá una vez regularizadas las tareas técnicas pendientes.
    </p>
  </main>

  <!-- Footer -->
  <footer class="w-full max-w-4xl pt-6 pb-2 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400 relative z-10">
    <div class="flex items-center gap-2">
      <img src="/images/logo.svg" alt="JB Logo" class="w-5 h-5 object-contain opacity-60" onerror="this.src='/images/logo.png';" />
      <span>© {new Date().getFullYear()} JB Ingeniería Corporativa S.R.L.</span>
    </div>
    <div class="font-mono text-[11px] text-slate-500">
      ID: SRV-MAINT-503
    </div>
  </footer>
</div>
