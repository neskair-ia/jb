---
import { CONTACT } from '../config';
---

<section id="contact" class="py-24 bg-slate-50 dark:bg-slate-900 border-t border-slate-100 dark:border-slate-800">
  <div class="container mx-auto px-4 text-center animate-on-scroll">
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-6 text-slate-900 dark:text-white">
      ¿Listo para empezar?
    </h2>
    <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-12">
      Contáctanos hoy mismo y descubre cómo podemos transformar tu presencia digital con una plataforma de alto rendimiento.
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-6">
      <!-- Botón de Email Seguro -->
      <button 
        class="secure-contact-btn group inline-flex h-14 items-center justify-center gap-2 rounded-full bg-blue-600 px-8 font-medium text-white transition-all hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/30"
        data-type="email"
        data-target={CONTACT.emailBase64}
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Enviar Mensaje</span>
      </button>

      <!-- Botón de Teléfono Seguro -->
      <button 
        class="secure-contact-btn group inline-flex h-14 items-center justify-center gap-2 rounded-full bg-white dark:bg-slate-800 px-8 font-medium text-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 transition-all hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400"
        data-type="tel"
        data-target={CONTACT.phoneBase64}
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Llámanos</span>
      </button>
    </div>
  </div>
</section>

<script>
  // Lógica Anti-Spam: Descifrar Base64 solo tras la interacción humana
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.secure-contact-btn');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetBtn = e.currentTarget as HTMLButtonElement;
        const type = targetBtn.dataset.type;
        const base64Data = targetBtn.dataset.target;
        
        if (base64Data) {
          try {
            const decoded = atob(base64Data);
            if (type === 'email') {
              window.location.href = `mailto:${decoded}`;
            } else if (type === 'tel') {
              window.location.href = `tel:${decoded}`;
            }
          } catch (error) {
            console.error('Error al procesar el contacto seguro.');
          }
        }
      });
    });
  });
</script>
