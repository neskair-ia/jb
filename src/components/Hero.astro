<style>
  @keyframes text-glow {
    0%, 100% { 
      text-shadow: 0 0 10px rgba(255, 252, 252, 0.2), 0 0 20px rgba(255, 252, 252, 0.1); 
    }
    50% { 
      text-shadow: 0 0 15px rgba(255, 252, 252, 0.6), 0 0 30px rgba(255, 252, 252, 0.4), 0 0 45px rgba(255, 252, 252, 0.2); 
    }
  }
  .animate-text-glow {
    animation: text-glow 4s ease-in-out infinite;
  }
  
  /* Animación épica de armado del Hero coordinada con la pantalla de carga (2.0s) */
  .hero-assemble {
    animation: assemble 1.2s cubic-bezier(0.16, 1, 0.3, 1) 2.0s both;
  }
  @keyframes assemble {
    0% {
      opacity: 0;
      transform: translateY(40px) scale(0.95);
      filter: blur(15px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }
</style>
