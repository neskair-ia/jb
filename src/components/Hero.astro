---
import { HERO } from '../config';
---

<section id="inicio" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-20">
  <!-- Background minimalista (sin brillos molestos) -->
  <div class="absolute inset-0 z-0 bg-transparent"></div>

  <div class="container mx-auto px-4 z-10 flex flex-col lg:flex-row items-center gap-12 animate-on-scroll">
    <div class="flex-1 text-center lg:text-left">
      <!-- Tag / Eyebrow -->
      <div class="inline-block text-[#FFFCFC]/70 uppercase tracking-widest text-xs font-semibold mb-6">
        Ingeniería Corporativa a Escala Industrial
      </div>

      <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        JB Ingeniería
        <br/>
        <span class="animate-text-glow inline-block text-[#FFFCFC]">
          Corporativa S.R.L
        </span>
      </h1>
      
      <p class="mt-4 text-xl md:text-2xl text-[#FFFCFC]/80 max-w-2xl mx-auto lg:mx-0 mb-10 leading-relaxed font-light">
        {HERO.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
        <a href="/nosotros" class="group relative inline-flex h-14 items-center justify-center overflow-hidden rounded-full bg-[#0e2146] px-8 font-medium text-[#FFFCFC] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_-10px_rgba(14,33,70,0.6)]">
          <span class="relative z-10 flex items-center gap-2">
            {HERO.ctaText}
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
        <a href="/proyectos" class="group inline-flex h-14 items-center justify-center rounded-full bg-transparent px-8 font-medium text-[#FFFCFC] border-2 border-[#FFFCFC]/20 hover:border-[#FFFCFC]/20 hover:bg-[#FFFCFC]/5 transition-colors">
          Ver Proyectos
        </a>
      </div>
    </div>
    
    <!-- Hero Image Placeholder for Glassmorphism -->
    <div class="flex-1 w-full relative max-w-lg lg:max-w-none">
      <div class="relative w-full aspect-square md:aspect-[4/3] lg:aspect-square rounded-[2rem] overflow-hidden bg-blue-600 border border-[#FFFCFC]/20 shadow-2xl backdrop-blur-xl flex items-center justify-center group">
        <!-- Placeholder text, easily replaced by an actual image or video tag later -->
        <div class="absolute inset-0 bg-gradient-to-br from-blue-400/5 to-transparent"></div>
        <div class="text-center p-8 relative z-10">
          <svg class="w-16 h-16 mx-auto mb-4 text-[#FFFCFC]/30 group-hover:scale-110 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-[#FFFCFC]/60 font-medium">Espacio para Imagen<br/>o Video Institucional</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes text-glow {
    0%, 100% { 
      text-shadow: 0 0 10px rgba(255, 252, 252, 0.2), 0 0 20px rgba(255, 252, 252, 0.1); 
    }
    50% { 
      text-shadow: 0 0 15px rgba(255, 252, 252, 0.6), 0 0 30px rgba(255, 252, 252, 0.4), 0 0 45px rgba(255, 252, 252, 0.2); 
    }
  }
  .animate-text-glow {
    animation: text-glow 4s ease-in-out infinite;
  }
</style>
