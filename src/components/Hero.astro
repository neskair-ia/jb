---
import { HERO } from '../config';

// Importamos las fotos de la carpeta inicio para el carrusel principal
const heroFiles = import.meta.glob('/public/inicio/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const heroImages = Object.keys(heroFiles).map(file => file.replace('/public', ''));
---

<section id="inicio" class="relative min-h-[100vh] flex items-center justify-center overflow-hidden pt-20 bg-[#1E2D64]">
  <!-- Background minimalista (sin brillos molestos) -->
  <div class="absolute inset-0 z-0 bg-transparent"></div>

  <!-- Background Image Area (Fading into the blue) -->
  <div class="absolute inset-0 lg:left-[35%] z-0 overflow-hidden">
    <!-- Gradient overlays to mimetize with the background -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#1E2D64] via-[#1E2D64]/60 to-transparent z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#1E2D64] via-transparent to-[#1E2D64] z-10"></div>
    <div class="absolute inset-0 bg-[#1E2D64]/20 z-10"></div>
    
    <!-- Rotating images -->
    {heroImages.length > 0 ? (
      heroImages.map((imgSrc, index) => (
        <img 
          src={imgSrc} 
          alt="JB Ingeniería Corporativa" 
          class={`hero-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-[2000ms] ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`} 
        />
      ))
    ) : (
      <!-- Fallback just in case -->
      <div class="absolute inset-0 bg-black/20 backdrop-blur-sm"></div>
    )}
  </div>

  <div class="container mx-auto px-4 z-10 relative flex items-center h-full">
    <div class="w-full lg:w-[60%] text-center lg:text-left py-12 md:py-20 lg:py-32 hero-assemble">
      <!-- Tag / Eyebrow -->
      <div class="inline-block text-[#FFFCFC]/70 uppercase tracking-widest text-xs font-semibold mb-6">
        Ingeniería Corporativa a Escala Industrial
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight mb-4 md:mb-6 text-[#FFFCFC]">
        JB Ingeniería
        <br/>
        <span class="animate-text-glow inline-block text-[#FFFCFC]">
          Corporativa S.R.L
        </span>
      </h1>
      
      <p class="mt-4 text-lg md:text-2xl text-[#FFFCFC]/80 max-w-2xl mx-auto lg:mx-0 mb-8 md:mb-10 leading-relaxed font-light">
        {HERO.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-5 flex-wrap">
        
        <!-- Botón Secundario: Conócenos -->
        <a href="/nosotros" class="w-full sm:w-auto group inline-flex h-12 md:h-14 items-center justify-center rounded-full bg-[#FFFCFC]/5 px-8 text-sm md:text-base font-medium text-[#FFFCFC] border border-[#FFFCFC]/20 backdrop-blur-md hover:bg-[#FFFCFC]/15 hover:border-[#FFFCFC]/60 hover:-translate-y-1 shadow-lg hover:shadow-[0_10px_20px_rgba(0,0,0,0.3)] transition-all duration-300">
          <span class="flex items-center gap-2">
            {HERO.ctaText}
            <svg class="w-4 h-4 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>

        <!-- Botón Secundario: Servicios -->
        <a href="/servicios" class="w-full sm:w-auto group inline-flex h-12 md:h-14 items-center justify-center rounded-full bg-[#FFFCFC]/5 px-8 text-sm md:text-base font-medium text-[#FFFCFC] border border-[#FFFCFC]/20 backdrop-blur-md hover:bg-[#FFFCFC]/15 hover:border-[#FFFCFC]/60 hover:-translate-y-1 shadow-lg hover:shadow-[0_10px_20px_rgba(0,0,0,0.3)] transition-all duration-300">
          <span class="flex items-center gap-2">
            Servicios
            <svg class="w-4 h-4 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>

        <!-- Botón Principal: Proyectos -->
        <a href="/proyectos" class="w-full sm:w-auto group relative inline-flex h-12 md:h-14 items-center justify-center overflow-hidden rounded-full bg-[#FFFCFC] px-8 text-sm md:text-base font-bold text-[#1E2D64] shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:shadow-[0_0_35px_rgba(255,255,255,0.5)] transition-all duration-300 hover:-translate-y-1">
          <span class="relative z-10 flex items-center gap-2">
            Ver Proyectos
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

      </div>
    </div>
  </div>
</section>

<style>
  @keyframes text-glow {
    0%, 100% { 
      text-shadow: 0 0 10px rgba(255, 252, 252, 0.2), 0 0 20px rgba(255, 252, 252, 0.1); 
    }
    50% { 
      text-shadow: 0 0 15px rgba(255, 252, 252, 0.6), 0 0 30px rgba(255, 252, 252, 0.4), 0 0 45px rgba(255, 252, 252, 0.2); 
    }
  }
  .animate-text-glow {
    animation: text-glow 4s ease-in-out infinite;
  }
  
  /* Animación épica de armado del Hero coordinada con la pantalla de carga (1.5s) */
  .hero-assemble {
    animation: assemble 1.2s cubic-bezier(0.16, 1, 0.3, 1) 1.5s both;
  }
  @keyframes assemble {
    0% {
      opacity: 0;
      transform: translateY(40px) scale(0.95);
      filter: blur(15px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }
</style>

<script>
  // Script para el carrusel del Hero
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    if (slides.length > 1) {
      let currentSlide = 0;
      
      setInterval(() => {
        // Ocultar slide actual
        slides[currentSlide].classList.replace('opacity-100', 'opacity-0');
        
        // Calcular siguiente slide
        currentSlide = (currentSlide + 1) % slides.length;
        
        // Mostrar nuevo slide
        slides[currentSlide].classList.replace('opacity-0', 'opacity-100');
      }, 5000); // 5 segundos por foto
    }
  });
</script>
