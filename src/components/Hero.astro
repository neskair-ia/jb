---
import { HERO } from '../config';

// Importamos las fotos de la carpeta inicio para el carrusel principal
const heroFiles = import.meta.glob('/public/inicio/*.{png,jpg,jpeg,webp,avif}');
const heroImages = Object.keys(heroFiles).map(file => file.replace('/public', ''));
---

<section id="inicio" class="relative min-h-[100vh] flex items-center justify-center overflow-hidden pt-20 bg-[#1E2D64]">
  <!-- Background minimalista (sin brillos molestos) -->
  <div class="absolute inset-0 z-0 bg-transparent"></div>

  <!-- Background Image Area -->
  <div class="absolute inset-0 lg:left-[35%] z-0 overflow-hidden">
    <!-- Gradient overlays (Desktop) -->
    <div class="hidden lg:block absolute inset-0 bg-gradient-to-r from-[#1E2D64] via-[#1E2D64]/30 to-transparent z-10 pointer-events-none"></div>
    <div class="hidden lg:block absolute inset-0 bg-gradient-to-t from-[#1E2D64] via-transparent to-[#1E2D64]/80 z-10 pointer-events-none"></div>
    
    <!-- Gradient overlays (Celular - Oscuro arriba para el texto, transparente abajo para ver la foto) -->
    <div class="lg:hidden absolute top-0 inset-x-0 h-[65%] bg-gradient-to-b from-[#1E2D64]/95 via-[#1E2D64]/40 to-transparent z-10 pointer-events-none"></div>
    
    <!-- Rotating images -->
    {heroImages.length > 0 ? (
      heroImages.map((imgSrc, index) => (
        <img 
          src={imgSrc} 
          alt="JB Ingeniería Corporativa" 
          class={`hero-slide absolute inset-0 w-full h-full object-cover ${index === 2 ? 'object-[75%_center]' : 'object-center'} transition-opacity duration-[2000ms] ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`} 
        />
      ))
    ) : (
      <div class="absolute inset-0 bg-black/20 backdrop-blur-sm"></div>
    )}
  </div>

  <div class="container mx-auto px-4 z-10 relative flex items-start lg:items-center h-full pt-16 lg:pt-0">
    <div class="w-full lg:w-[60%] text-center lg:text-left py-4 md:py-20 lg:py-32 hero-assemble">
      <!-- Tag / Eyebrow -->
      <div class="inline-block text-[#FFFCFC] uppercase tracking-widest text-[11px] md:text-xs font-bold mb-4 md:mb-6 drop-shadow-lg">
        Ingeniería Corporativa a Escala Industrial
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight mb-4 md:mb-6 text-[#FFFCFC] leading-[1.1] drop-shadow-lg">
        JB Ingeniería
        <br class="hidden sm:block"/>
        <span class="animate-text-glow inline-block text-[#FFFCFC]">
          Corporativa S.R.L
        </span>
      </h1>
      
      <p class="mt-2 md:mt-4 text-base md:text-2xl text-[#FFFCFC] max-w-2xl mx-auto lg:mx-0 mb-8 md:mb-10 leading-relaxed font-medium drop-shadow-lg">
        {HERO.subtitle}
      </p>

      <div class="flex flex-row items-center justify-center lg:justify-start gap-3 md:gap-5 flex-wrap">
        
        <!-- Botón Secundario: Conócenos -->
        <a href="/nosotros" class="group inline-flex h-11 md:h-14 items-center justify-center rounded-full bg-[#1E2D64]/90 md:bg-[#FFFCFC]/10 px-6 md:px-8 text-sm md:text-base font-medium text-[#FFFCFC] border border-[#FFFCFC]/30 backdrop-blur-md hover:bg-[#1E2D64] md:hover:bg-[#FFFCFC]/20 hover:border-[#FFFCFC]/60 hover:-translate-y-1 shadow-lg hover:shadow-[0_10px_20px_rgba(0,0,0,0.3)] transition-all duration-300">
          <span class="flex items-center gap-2">
            {HERO.ctaText}
            <svg class="w-4 h-4 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>

        <!-- Botón Secundario: Servicios -->
        <a href="/servicios" class="group inline-flex h-11 md:h-14 items-center justify-center rounded-full bg-[#1E2D64]/90 md:bg-[#FFFCFC]/10 px-6 md:px-8 text-sm md:text-base font-medium text-[#FFFCFC] border border-[#FFFCFC]/30 backdrop-blur-md hover:bg-[#1E2D64] md:hover:bg-[#FFFCFC]/20 hover:border-[#FFFCFC]/60 hover:-translate-y-1 shadow-lg hover:shadow-[0_10px_20px_rgba(0,0,0,0.3)] transition-all duration-300">
          <span class="flex items-center gap-2">
            Servicios
            <svg class="w-4 h-4 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>

        <!-- Botón Principal: Proyectos -->
        <a href="/proyectos" class="group relative inline-flex h-12 md:h-14 items-center justify-center overflow-hidden rounded-full bg-[#FFFCFC] px-8 md:px-8 text-sm md:text-base font-bold text-[#1E2D64] shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:shadow-[0_0_35px_rgba(255,255,255,0.5)] transition-all duration-300 hover:-translate-y-1">
          <span class="relative z-10 flex items-center gap-2">
            Proyectos
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

      </div>
    </div>
  </div>

  <!-- Animated Scroll Down Indicator (visible mostly on mobile or when not scrolled) -->
  <div class="absolute bottom-6 md:bottom-10 left-1/2 transform -translate-x-1/2 z-20 flex flex-col items-center justify-center animate-bounce-slow opacity-80 pointer-events-none">
    <span class="text-[10px] md:text-xs text-[#FFFCFC] uppercase tracking-widest font-semibold mb-2 drop-shadow-md">Deslizar</span>
    <div class="w-5 h-8 md:w-6 md:h-10 border-2 border-[#FFFCFC]/50 rounded-full flex justify-center p-1 backdrop-blur-sm">
      <div class="w-1 md:w-1.5 h-1 md:h-1.5 bg-[#FFFCFC] rounded-full animate-scroll-wheel"></div>
    </div>
  </div>
</section>

<style>
  @keyframes text-glow {
    0%, 100% { 
      text-shadow: 0 0 10px rgba(255, 252, 252, 0.2), 0 0 20px rgba(255, 252, 252, 0.1); 
    }
    50% { 
      text-shadow: 0 0 15px rgba(255, 252, 252, 0.6), 0 0 30px rgba(255, 252, 252, 0.4), 0 0 45px rgba(255, 252, 252, 0.2); 
    }
  }
  .animate-text-glow {
    animation: text-glow 4s ease-in-out infinite;
  }
  
  /* Animación épica de armado del Hero coordinada con la pantalla de carga (1.5s) */
  .hero-assemble {
    animation: assemble 1.2s cubic-bezier(0.16, 1, 0.3, 1) 1.5s both;
  }
  @keyframes assemble {
    0% {
      opacity: 0;
      transform: translateY(40px) scale(0.95);
      filter: blur(15px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  /* Animaciones para el indicador de scroll */
  @keyframes bounce-slow {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }
  .animate-bounce-slow {
    animation: bounce-slow 2.5s infinite ease-in-out;
  }

  @keyframes scroll-wheel {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(12px); opacity: 0; }
  }
  .animate-scroll-wheel {
    animation: scroll-wheel 1.5s infinite cubic-bezier(0.15, 0.41, 0.69, 0.94);
  }
</style>

<script>
  // Script para el carrusel del Hero
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    if (slides.length > 1) {
      let currentSlide = 0;
      
      setInterval(() => {
        // Ocultar slide actual
        slides[currentSlide].classList.replace('opacity-100', 'opacity-0');
        
        // Calcular siguiente slide
        currentSlide = (currentSlide + 1) % slides.length;
        
        // Mostrar nuevo slide
        slides[currentSlide].classList.replace('opacity-0', 'opacity-100');
      }, 5000); // 5 segundos por foto
    }
  });
</script>
