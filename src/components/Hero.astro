---
import { HERO } from '../config';
---

<section id="inicio" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-20">
  <!-- Background minimalista (sin brillos molestos) -->
  <div class="absolute inset-0 z-0 bg-transparent"></div>

  <!-- Background Video Area -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <!-- Gradient overlays to mimetize with the background and make text readable -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0e2146] via-[#0e2146]/80 to-[#0e2146]/30 z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0e2146] via-transparent to-[#0e2146]/50 z-10"></div>
    
    <!-- Capa sutil de color para que el video se tiña del tono corporativo sin verse negro/crudo -->
    <div class="absolute inset-0 bg-[#1E2D64]/30 mix-blend-multiply z-10"></div>
    <div class="absolute inset-0 bg-[#0e2146]/40 z-10"></div>
    
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      class="absolute inset-0 w-full h-full object-cover opacity-90"
    >
      <!-- Usando el nombre exacto que tiene el archivo actualmente -->
      <source src="/hero-video.mp4.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="container mx-auto px-4 z-10 relative flex items-center h-full">
    <div class="w-full lg:w-[60%] text-center lg:text-left py-20 lg:py-32 animate-on-scroll">
      <!-- Tag / Eyebrow -->
      <div class="inline-block text-[#FFFCFC]/70 uppercase tracking-widest text-xs font-semibold mb-6">
        Ingeniería Corporativa a Escala Industrial
      </div>

      <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        JB Ingeniería
        <br/>
        <span class="animate-text-glow inline-block text-[#FFFCFC]">
          Corporativa S.R.L
        </span>
      </h1>
      
      <p class="mt-4 text-xl md:text-2xl text-[#FFFCFC]/80 max-w-2xl mx-auto lg:mx-0 mb-10 leading-relaxed font-light">
        {HERO.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 flex-wrap">
        <a href="/nosotros" class="group relative inline-flex h-14 items-center justify-center overflow-hidden rounded-full bg-transparent px-8 font-medium text-[#FFFCFC] border-2 border-[#FFFCFC]/20 transition-all duration-300 hover:scale-105 hover:border-[#FFFCFC]/40 hover:bg-[#FFFCFC]/5">
          <span class="relative z-10 flex items-center gap-2">
            {HERO.ctaText}
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
        <a href="/servicios" class="group inline-flex h-14 items-center justify-center rounded-full bg-transparent px-8 font-medium text-[#FFFCFC] border-2 border-[#FFFCFC]/20 hover:border-[#FFFCFC]/40 hover:bg-[#FFFCFC]/5 transition-colors">
          Servicios
        </a>
        <a href="/proyectos" class="group inline-flex h-14 items-center justify-center rounded-full bg-transparent px-8 font-medium text-[#FFFCFC] border-2 border-[#FFFCFC]/20 hover:border-[#FFFCFC]/40 hover:bg-[#FFFCFC]/5 transition-colors">
          Ver Proyectos
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes text-glow {
    0%, 100% { 
      text-shadow: 0 0 10px rgba(255, 252, 252, 0.2), 0 0 20px rgba(255, 252, 252, 0.1); 
    }
    50% { 
      text-shadow: 0 0 15px rgba(255, 252, 252, 0.6), 0 0 30px rgba(255, 252, 252, 0.4), 0 0 45px rgba(255, 252, 252, 0.2); 
    }
  }
  .animate-text-glow {
    animation: text-glow 4s ease-in-out infinite;
  }
</style>
