---
import { HERO } from '../config';

// Importamos las fotos de la carpeta inicio para el carrusel principal
const heroFiles = import.meta.glob('/public/inicio/*.{png,jpg,jpeg,webp,avif}');
const heroImages = Object.keys(heroFiles).map(file => file.replace('/public', ''));
---

<section id="inicio" class="relative min-h-[100vh] flex items-center justify-center overflow-hidden pt-20 bg-[#1E2D64]">
  <!-- Background minimalista (sin brillos molestos) -->
  <div class="absolute inset-0 z-0 bg-transparent"></div>

  <!-- Background Image Area -->
  <div class="absolute inset-0 lg:left-[35%] z-0 overflow-hidden">
    <!-- Gradient overlays (Desktop) -->
    <div class="hidden lg:block absolute inset-0 bg-gradient-to-r from-[#1E2D64] via-[#1E2D64]/30 to-transparent z-10 pointer-events-none"></div>
    <div class="hidden lg:block absolute inset-0 bg-gradient-to-t from-[#1E2D64] via-transparent to-[#1E2D64]/80 z-10 pointer-events-none"></div>
    
    <!-- Gradient overlays (Celular - Oscuro arriba para el texto, transparente abajo para ver la foto) -->
    <div class="lg:hidden absolute top-0 inset-x-0 h-[65%] bg-gradient-to-b from-[#1E2D64]/95 via-[#1E2D64]/40 to-transparent z-10 pointer-events-none"></div>
    
    <!-- Rotating images -->
    {heroImages.length > 0 ? (
      heroImages.map((imgSrc, index) => (
        <img 
          src={imgSrc} 
          alt="JB Ingeniería Corporativa" 
          class={`hero-slide absolute inset-0 w-full h-full object-cover ${index === 2 ? 'object-[75%_center]' : 'object-center'} transition-opacity duration-[2000ms] ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`} 
        />
      ))
    ) : (
      <div class="absolute inset-0 bg-black/20 backdrop-blur-sm"></div>
    )}
  </div>

  <div class="container mx-auto px-4 z-10 relative flex items-start lg:items-center h-full pt-16 lg:pt-0">
    <div class="w-full lg:w-[60%] text-center lg:text-left py-4 md:py-20 lg:py-32">
      <!-- Tag / Eyebrow -->
      <div class="inline-block text-[#FFFCFC] uppercase tracking-widest text-[11px] md:text-xs font-bold mb-4 md:mb-6 drop-shadow-lg">
        Ingeniería Corporativa a Escala Industrial
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight mb-4 md:mb-6 text-[#FFFCFC] leading-[1.1] drop-shadow-lg animate-text-glow">
        JB Ingeniería<span class="sm:hidden"> </span><br class="hidden sm:block"/>
        Corporativa S.R.L
      </h1>
      
      <p class="mt-2 md:mt-4 text-base md:text-2xl text-[#FFFCFC] max-w-2xl mx-auto lg:mx-0 mb-6 md:mb-8 leading-relaxed font-medium drop-shadow-lg">
        {HERO.subtitle}
      </p>

      <!-- Insignias de Confianza (Minimalistas, sin emojis) -->
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 sm:gap-3.5 mb-8 md:mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#FFFCFC]/10 border border-[#FFFCFC]/20 backdrop-blur-md shadow-sm hover:bg-[#FFFCFC]/15 transition-colors">
          <svg class="w-4 h-4 text-blue-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="text-xs sm:text-sm font-semibold text-[#FFFCFC] tracking-wide">Cobertura en las 24 Provincias</span>
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#FFFCFC]/10 border border-[#FFFCFC]/20 backdrop-blur-md shadow-sm hover:bg-[#FFFCFC]/15 transition-colors">
          <svg class="w-4 h-4 text-blue-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          <span class="text-xs sm:text-sm font-semibold text-[#FFFCFC] tracking-wide">Certificación Oficial 3M</span>
        </div>
      </div>

      <div class="flex flex-row items-center justify-center lg:justify-start gap-3 md:gap-5 flex-wrap">
        
        <!-- Botón Secundario: Conócenos (Titanio Cepillado Industrial) -->
        <a href="/nosotros/" class="group btn-metallic-titanium inline-flex h-12 md:h-14 items-center justify-center rounded-full px-6 md:px-8 text-sm md:text-base font-semibold text-[#FFFCFC] tracking-wide whitespace-nowrap">
          <span class="metallic-shine-dark"></span>
          <span class="relative z-10 flex items-center gap-2 drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]">
            {HERO.ctaText}
            <svg class="w-4 h-4 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>

        <!-- Botón Secundario: Servicios (Titanio Cepillado Industrial) -->
        <a href="/servicios/" class="group btn-metallic-titanium inline-flex h-12 md:h-14 items-center justify-center rounded-full px-6 md:px-8 text-sm md:text-base font-semibold text-[#FFFCFC] tracking-wide whitespace-nowrap">
          <span class="metallic-shine-dark"></span>
          <span class="relative z-10 flex items-center gap-2 drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]">
            Servicios
            <svg class="w-4 h-4 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>

        <!-- Botón Principal: Proyectos (Acero Líquido / Cromo Pulido CNC) -->
        <a href="/proyectos/" class="group btn-metallic-steel inline-flex h-12 md:h-14 items-center justify-center rounded-full px-7 md:px-9 text-sm md:text-base font-extrabold text-[#0B1536] tracking-tight whitespace-nowrap">
          <span class="metallic-shine"></span>
          <span class="relative z-10 flex items-center gap-2.5 drop-shadow-[0_1px_0_rgba(255,255,255,0.9)]">
            Proyectos
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5 text-[#0B1536]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

      </div>

      <!-- Social Proof (Estrellas y Logos) -->
      <a href="https://share.google/0vSbehj4lAvdtl8RY" target="_blank" rel="noopener noreferrer" class="mt-8 md:mt-12 flex flex-row items-center justify-center lg:justify-start gap-4 sm:gap-6 bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 backdrop-blur-md px-4 sm:px-6 py-3 sm:py-4 rounded-[2rem] shadow-lg hover:bg-[#FFFCFC]/15 hover:scale-105 hover:-translate-y-1 transition-all duration-300 cursor-pointer drop-shadow-xl animate-fade-in-up w-fit mx-auto lg:mx-0 group">
        <!-- Avatares separados (Logos reales) -->
        <div class="flex gap-2 sm:gap-3 items-center">
          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full border border-[#FFFCFC]/20 bg-[#FFFCFC] text-[#1E2D64] flex items-center justify-center text-[10px] sm:text-[11px] font-bold shadow-sm group-hover:bg-blue-100 transition-colors">+50</div>
        </div>
        
        <!-- Estrellas y texto -->
        <div class="flex flex-col items-start border-l border-[#FFFCFC]/20 pl-4 sm:pl-6">
          <div class="flex items-center gap-1 text-[#FFC107] drop-shadow-[0_0_8px_rgba(255,193,7,0.6)] mb-1">
            {[1, 2, 3, 4, 5].map(() => (
              <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-5 md:h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <span class="text-xs sm:text-sm md:text-sm font-semibold text-[#FFFCFC]/90 drop-shadow-md tracking-tight group-hover:text-white transition-colors">
            Ver reseñas en Google
          </span>
        </div>
      </a>

    </div>
  </div>

  <!-- Animated Scroll Down Indicator -->
  <div class="absolute inset-x-0 bottom-6 md:bottom-10 z-20 flex justify-center pointer-events-none">
    <div class="flex flex-col items-center justify-center animate-bounce-slow opacity-80">
      <span class="text-[10px] md:text-xs text-[#FFFCFC] uppercase tracking-widest font-semibold mb-2 drop-shadow-md">Deslizar</span>
      <div class="w-5 h-8 md:w-6 md:h-10 border-2 border-[#FFFCFC]/50 rounded-full flex justify-center p-1 backdrop-blur-sm">
        <div class="w-1 md:w-1.5 h-1 md:h-1.5 bg-[#FFFCFC] rounded-full animate-scroll-wheel"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ========================================================
     BOTONES METÁLICOS INDUSTRIALES (ESTILO JB INGENIERÍA)
     ======================================================== */

  /* Botón Principal: Acero Líquido / Cromo Pulido */
  .btn-metallic-steel {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      140deg,
      #ffffff 0%,
      #f8fafc 18%,
      #e2e8f0 44%,
      #cbd5e1 49%,
      #94a3b8 51%,
      #f1f5f9 55%,
      #ffffff 82%,
      #e2e8f0 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow: 
      inset 0 1.5px 1px 0 #ffffff,
      inset 0 -2px 3px 0 rgba(71, 85, 105, 0.4),
      0 10px 25px -4px rgba(0, 0, 0, 0.45),
      0 0 25px rgba(255, 255, 255, 0.35);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-metallic-steel:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 
      inset 0 2px 2px 0 #ffffff,
      inset 0 -2px 4px 0 rgba(51, 65, 85, 0.5),
      0 18px 35px -5px rgba(0, 0, 0, 0.55),
      0 0 35px rgba(255, 255, 255, 0.65);
  }

  /* Botones Secundarios: Titanio Cepillado / Acero Industrial */
  .btn-metallic-titanium {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      140deg,
      rgba(255, 255, 255, 0.28) 0%,
      rgba(255, 255, 255, 0.1) 32%,
      rgba(15, 23, 42, 0.6) 47%,
      rgba(30, 45, 100, 0.8) 52%,
      rgba(255, 255, 255, 0.18) 75%,
      rgba(255, 255, 255, 0.08) 100%
    );
    background-color: rgba(18, 28, 64, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 
      inset 0 1.5px 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.55),
      0 10px 22px -4px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-metallic-titanium:hover {
    transform: translateY(-2px);
    border-color: rgba(147, 197, 253, 0.85);
    background-color: rgba(28, 45, 98, 0.9);
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.8),
      inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.4),
      0 16px 32px -4px rgba(0, 0, 0, 0.5),
      0 0 25px rgba(59, 130, 246, 0.45);
  }

  /* Reflejo / Shimmer Metálico Dinámico */
  .metallic-shine {
    position: absolute;
    top: -50%;
    bottom: -50%;
    left: -120%;
    width: 60%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.7) 50%,
      transparent 100%
    );
    transform: skewX(-25deg);
    pointer-events: none;
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn-metallic-steel:hover .metallic-shine {
    transform: translateX(450%) skewX(-25deg);
  }

  .metallic-shine-dark {
    position: absolute;
    top: -50%;
    bottom: -50%;
    left: -120%;
    width: 60%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.4) 50%,
      transparent 100%
    );
    transform: skewX(-25deg);
    pointer-events: none;
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn-metallic-titanium:hover .metallic-shine-dark {
    transform: translateX(450%) skewX(-25deg);
  }

  @keyframes text-glow {
    0%, 100% { 
      text-shadow: 0 0 10px rgba(255, 252, 252, 0.2), 0 0 20px rgba(255, 252, 252, 0.1); 
    }
    50% { 
      text-shadow: 0 0 15px rgba(255, 252, 252, 0.6), 0 0 30px rgba(255, 252, 252, 0.4), 0 0 45px rgba(255, 252, 252, 0.2); 
    }
  }
  .animate-text-glow {
    animation: text-glow 4s ease-in-out infinite;
  }
  
  /* Se removió hero-assemble para optimizar la carga en celulares y evitar pantallazos blancos */

  /* Animaciones para el indicador de scroll */
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
  .animate-bounce-slow {
    animation: bounce-slow 2.5s infinite ease-in-out;
  }

  @keyframes scroll-wheel {
    0% { transform: translateY(12px); opacity: 0; }
    50% { opacity: 1; }
    100% { transform: translateY(0); opacity: 0; }
  }
  .animate-scroll-wheel {
    animation: scroll-wheel 1.5s infinite cubic-bezier(0.15, 0.41, 0.69, 0.94);
  }
</style>

<script>
  // Script para el carrusel del Hero
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    if (slides.length > 1) {
      let currentSlide = 0;
      
      setInterval(() => {
        // Ocultar slide actual
        slides[currentSlide].classList.replace('opacity-100', 'opacity-0');
        
        // Calcular siguiente slide
        currentSlide = (currentSlide + 1) % slides.length;
        
        // Mostrar nuevo slide
        slides[currentSlide].classList.replace('opacity-0', 'opacity-100');
      }, 8000); // 8 segundos por foto
    }
  });
</script>
