---
import { HERO } from '../config';
---

<section id="inicio" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-20">
  <!-- Background Elements -->
  <div class="absolute inset-0 z-0 bg-white">
    <!-- Subtitle Glassmorphism Background Shapes -->
    <div class="absolute top-10 left-1/4 w-[500px] h-[500px] bg-[#0e2146]/5 rounded-full mix-blend-multiply filter blur-3xl opacity-60 animate-blob"></div>
    <div class="absolute top-20 right-1/4 w-[400px] h-[400px] bg-blue-100/40 rounded-full mix-blend-multiply filter blur-3xl opacity-60 animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-32 left-1/3 w-[600px] h-[600px] bg-slate-100/50 rounded-full mix-blend-multiply filter blur-3xl opacity-60 animate-blob animation-delay-4000"></div>
    
    <!-- Grid Pattern (Subtle) -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#0e214605_1px,transparent_1px),linear-gradient(to_bottom,#0e214605_1px,transparent_1px)] bg-[size:32px_32px]"></div>
  </div>

  <div class="container mx-auto px-4 z-10 flex flex-col lg:flex-row items-center gap-12 animate-on-scroll">
    <div class="flex-1 text-center lg:text-left">
      <!-- Tag / Eyebrow -->
      <div class="inline-block px-4 py-1.5 rounded-full bg-[#0e2146]/5 border border-[#0e2146]/10 text-[#0e2146] text-sm font-semibold mb-6 backdrop-blur-sm">
        Ingeniería Corporativa a Escala Industrial
      </div>

      <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 text-[#0e2146]">
        JB Ingeniería
        <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0e2146] to-blue-600">
          Corporativa S.R.L
        </span>
      </h1>
      
      <p class="mt-4 text-xl md:text-2xl text-slate-600 max-w-2xl mx-auto lg:mx-0 mb-10 leading-relaxed font-light">
        {HERO.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
        <a href="#nosotros" class="group relative inline-flex h-14 items-center justify-center overflow-hidden rounded-full bg-[#0e2146] px-8 font-medium text-white transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_-10px_rgba(14,33,70,0.6)]">
          <span class="relative z-10 flex items-center gap-2">
            {HERO.ctaText}
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
        <a href="#proyectos" class="group inline-flex h-14 items-center justify-center rounded-full bg-white px-8 font-medium text-[#0e2146] border-2 border-[#0e2146]/10 hover:border-[#0e2146]/30 hover:bg-slate-50 transition-colors">
          Ver Proyectos
        </a>
      </div>
    </div>
    
    <!-- Hero Image Placeholder for Glassmorphism -->
    <div class="flex-1 w-full relative max-w-lg lg:max-w-none">
      <div class="relative w-full aspect-square md:aspect-[4/3] lg:aspect-square rounded-[2rem] overflow-hidden bg-[#0e2146]/5 border border-white/20 shadow-2xl backdrop-blur-xl flex items-center justify-center group">
        <!-- Placeholder text, easily replaced by an actual image or video tag later -->
        <div class="absolute inset-0 bg-gradient-to-br from-[#0e2146]/5 to-transparent"></div>
        <div class="text-center p-8 relative z-10">
          <svg class="w-16 h-16 mx-auto mb-4 text-[#0e2146]/30 group-hover:scale-110 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-[#0e2146]/60 font-medium">Espacio para Imagen<br/>o Video Institucional</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>
