---
import { SERVICES, SERVICES_INTRO, SERVICES_INTRO_MOBILE, PILLARS } from '../config';

const serviceFiles = import.meta.glob('/public/servicios/*.{png,jpg,jpeg,webp,avif}');
const serviceImages: Record<string, string> = {};
Object.keys(serviceFiles).forEach(file => {
  const fileName = file.split('/').pop()?.split('.')[0];
  if (fileName) {
    serviceImages[fileName] = file.replace('/public', '');
  }
});
---

<section id="servicios" class="pt-28 pb-16 md:py-32 bg-transparent relative overflow-hidden">
  <div class="max-w-7xl mx-auto w-full px-4 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        Qué Hacemos
      </h2>
      <!-- Texto versión Desktop -->
      <p class="hidden md:block text-lg text-[#FFFCFC]/80 leading-relaxed font-light">
        {SERVICES_INTRO}
      </p>
      <!-- Texto versión Celular (Más corto y directo) -->
      <p class="md:hidden text-[15px] text-[#FFFCFC]/90 leading-relaxed px-2 font-medium">
        {SERVICES_INTRO_MOBILE}
      </p>
    </div>

    <!-- Catálogo de Servicios (Visual Principal) -->
    <div class="max-w-[95rem] mx-auto mb-20 md:mb-28">
      <!-- Grid de 3 columnas para destacar fotos -->
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-x-8 md:gap-y-16">
        {SERVICES.map((service, index) => (
          <div class="group cursor-default flex flex-col gap-5">
            
            <div class="relative w-full aspect-[4/5] rounded-2xl md:rounded-[2rem] overflow-hidden shadow-xl bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 transition-transform duration-500 group-hover:-translate-y-2 group-hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.5)]">
              <img 
                src={serviceImages[service.id.toString()] || `https://placehold.co/800x1000/0A1538/FFFCFC?text=${service.title.split(' ').join('+')}`} 
                alt={service.title} 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1E2D64]/90 via-[#1E2D64]/50 to-transparent opacity-90 group-hover:opacity-80 transition-opacity duration-500"></div>
              
              <!-- Contenido del servicio con gradiente suave pero sin difuminado (blur) -->
              <div class="absolute inset-x-0 bottom-0 p-4 md:p-8 pt-12 md:pt-24 flex flex-col justify-end bg-gradient-to-t from-[#1E2D64] via-[#1E2D64]/60 to-transparent transition-all duration-500 rounded-b-2xl md:rounded-b-[2rem]">
                <h4 class="text-base md:text-2xl font-bold text-[#FFFCFC] mb-2 md:mb-3 group-hover:text-blue-300 transition-colors leading-tight">{service.title}</h4>
                <p class="text-[#FFFCFC]/90 text-[11px] md:text-base leading-snug md:leading-relaxed line-clamp-3 lg:line-clamp-3 group-hover:line-clamp-none transition-all duration-500 hidden sm:block">
                  {service.description}
                </p>
              </div>
            </div>
            
          </div>
        ))}
      </div>
    </div>

    <!-- Proceso Llave en Mano -->
    <div class="max-w-7xl mx-auto mb-20 md:mb-32 border-t border-[#FFFCFC]/10 pt-16 md:pt-24">
      <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
        <div class="inline-block px-4 py-1.5 rounded-full bg-[#FFFCFC]/10 border border-[#FFFCFC]/20 text-blue-300 text-xs md:text-sm font-semibold mb-4 backdrop-blur-md">
          Solución Integral
        </div>
        <h3 class="text-3xl md:text-5xl font-bold tracking-tight mb-4 text-[#FFFCFC]">
          Proceso Llave en Mano
        </h3>
        <p class="text-sm md:text-lg text-[#FFFCFC]/80 font-light max-w-2xl mx-auto leading-relaxed">
          Coordinamos cada etapa con tecnología propia y personal certificado para que tu empresa solo tenga que recibir la obra terminada.
        </p>
      </div>

      <!-- Grid de los 4 Pasos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        
        <!-- Paso 01 -->
        <div class="relative group p-6 md:p-8 rounded-2xl md:rounded-[2rem] bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 backdrop-blur-xl shadow-xl hover:-translate-y-2 hover:bg-[#FFFCFC]/10 hover:border-blue-400/40 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-blue-500 font-mono">01</span>
              <div class="w-10 h-10 rounded-full bg-blue-500/10 border border-blue-400/20 flex items-center justify-center text-blue-300 group-hover:scale-110 group-hover:bg-blue-500/20 transition-all">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
            <h4 class="text-lg md:text-xl font-bold text-[#FFFCFC] mb-2.5 leading-snug group-hover:text-blue-300 transition-colors">
              Ingeniería y Diseño
            </h4>
            <p class="text-xs md:text-sm text-[#FFFCFC]/75 leading-relaxed font-light">
              Renders, cálculo de estructuras y planimetría.
            </p>
          </div>
          <div class="w-full h-1 bg-gradient-to-r from-blue-400/0 via-blue-400/30 to-blue-400/0 mt-6 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>

        <!-- Paso 02 -->
        <div class="relative group p-6 md:p-8 rounded-2xl md:rounded-[2rem] bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 backdrop-blur-xl shadow-xl hover:-translate-y-2 hover:bg-[#FFFCFC]/10 hover:border-blue-400/40 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-blue-500 font-mono">02</span>
              <div class="w-10 h-10 rounded-full bg-blue-500/10 border border-blue-400/20 flex items-center justify-center text-blue-300 group-hover:scale-110 group-hover:bg-blue-500/20 transition-all">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
            </div>
            <h4 class="text-lg md:text-xl font-bold text-[#FFFCFC] mb-2.5 leading-snug group-hover:text-blue-300 transition-colors">
              Fabricación CNC
            </h4>
            <p class="text-xs md:text-sm text-[#FFFCFC]/75 leading-relaxed font-light">
              Corte láser de fibra, plegado de precisión y soldadura certificada.
            </p>
          </div>
          <div class="w-full h-1 bg-gradient-to-r from-blue-400/0 via-blue-400/30 to-blue-400/0 mt-6 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>

        <!-- Paso 03 -->
        <div class="relative group p-6 md:p-8 rounded-2xl md:rounded-[2rem] bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 backdrop-blur-xl shadow-xl hover:-translate-y-2 hover:bg-[#FFFCFC]/10 hover:border-blue-400/40 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-blue-500 font-mono">03</span>
              <div class="w-10 h-10 rounded-full bg-blue-500/10 border border-blue-400/20 flex items-center justify-center text-blue-300 group-hover:scale-110 group-hover:bg-blue-500/20 transition-all">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
            </div>
            <h4 class="text-lg md:text-xl font-bold text-[#FFFCFC] mb-2.5 leading-snug group-hover:text-blue-300 transition-colors">
              Tratamiento y Terminación
            </h4>
            <p class="text-xs md:text-sm text-[#FFFCFC]/75 leading-relaxed font-light">
              Pintura electrostática secada en horno para máxima durabilidad UV.
            </p>
          </div>
          <div class="w-full h-1 bg-gradient-to-r from-blue-400/0 via-blue-400/30 to-blue-400/0 mt-6 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>

        <!-- Paso 04 -->
        <div class="relative group p-6 md:p-8 rounded-2xl md:rounded-[2rem] bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 backdrop-blur-xl shadow-xl hover:-translate-y-2 hover:bg-[#FFFCFC]/10 hover:border-blue-400/40 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-blue-500 font-mono">04</span>
              <div class="w-10 h-10 rounded-full bg-blue-500/10 border border-blue-400/20 flex items-center justify-center text-blue-300 group-hover:scale-110 group-hover:bg-blue-500/20 transition-all">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              </div>
            </div>
            <h4 class="text-lg md:text-xl font-bold text-[#FFFCFC] mb-2.5 leading-snug group-hover:text-blue-300 transition-colors">
              Montaje Nacional
            </h4>
            <p class="text-xs md:text-sm text-[#FFFCFC]/75 leading-relaxed font-light">
              Logística propia e instalación en cualquier punto del país.
            </p>
          </div>
          <div class="w-full h-1 bg-gradient-to-r from-blue-400/0 via-blue-400/30 to-blue-400/0 mt-6 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>

      </div>
    </div>

    <!-- Pilares de Servicio (Secundario) -->
    <div class="max-w-7xl mx-auto border-t border-[#FFFCFC]/10 pt-16 md:pt-24">
      <h3 class="text-3xl md:text-5xl font-bold mb-12 md:mb-16 text-center text-[#FFFCFC] animate-on-scroll">Por qué elegirnos</h3>
      <div class="grid grid-cols-2 gap-2 sm:gap-4 md:gap-8">
        {PILLARS.map((pillar, index) => (
          <div class="animate-on-scroll" style={`transition-delay: ${index * 100}ms`}>
            <div class="h-full p-4 sm:p-6 md:p-12 rounded-2xl md:rounded-[2.5rem] bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 shadow-xl hover:-translate-y-2 hover:scale-[1.02] hover:bg-[#FFFCFC]/10 hover:border-[#FFFCFC]/30 transition-all duration-300 backdrop-blur-xl flex flex-col justify-center">
              <h3 class="text-[13px] sm:text-lg md:text-3xl font-bold mb-2 md:mb-5 text-[#FFFCFC] leading-tight">{pillar.title}</h3>
              <p class="text-blue-50 text-[10px] sm:text-sm md:text-lg leading-snug md:leading-relaxed font-light">{pillar.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
