---
import { SERVICES, SERVICES_INTRO, SERVICES_INTRO_MOBILE, PILLARS } from '../config';

const serviceFiles = import.meta.glob('/public/servicios/*.{png,jpg,jpeg,webp,avif}');
const serviceImages: Record<string, string> = {};
Object.keys(serviceFiles).forEach(file => {
  const fileName = file.split('/').pop()?.split('.')[0];
  if (fileName) {
    serviceImages[fileName] = file.replace('/public', '');
  }
});
---

<section id="servicios" class="py-16 md:py-32 bg-transparent relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        Qué Hacemos
      </h2>
      <!-- Texto versión Desktop -->
      <p class="hidden md:block text-lg text-[#FFFCFC]/80 leading-relaxed font-light">
        {SERVICES_INTRO}
      </p>
      <!-- Texto versión Celular (Más corto y directo) -->
      <p class="md:hidden text-[15px] text-[#FFFCFC]/90 leading-relaxed px-2 font-medium">
        {SERVICES_INTRO_MOBILE}
      </p>
    </div>

    <!-- Catálogo de Servicios (Visual Principal) -->
    <div class="max-w-[95rem] mx-auto mb-20 md:mb-32">
      <!-- Grid de 3 columnas para destacar fotos -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 md:gap-x-8 gap-y-12 md:gap-y-16">
        {SERVICES.map((service, index) => (
          <div class="group cursor-default flex flex-col gap-5">
            
            <!-- Imagen Limpia (Sin Filtros) -->
            <div class="relative w-full aspect-[4/5] rounded-[2rem] overflow-hidden shadow-xl bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 transition-transform duration-500 group-hover:-translate-y-2 group-hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.5)]">
              <img 
                src={serviceImages[service.id.toString()] || `https://placehold.co/800x1000/0A1538/FFFCFC?text=${service.title.split(' ').join('+')}`} 
                alt={service.title} 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              />
            </div>
            
            <!-- Texto acompañante (Minimalista) -->
            <div class="flex flex-col px-2">
              <h4 class="text-2xl font-bold text-[#FFFCFC] mb-3 group-hover:text-blue-300 transition-colors">{service.title}</h4>
              <p class="text-[#FFFCFC]/70 text-[15px] leading-relaxed font-light">
                {service.description}
              </p>
            </div>
            
          </div>
        ))}
      </div>
    </div>

    <!-- Pilares de Servicio (Secundario) -->
    <div class="max-w-7xl mx-auto border-t border-[#FFFCFC]/10 pt-16 md:pt-24">
      <h3 class="text-2xl font-bold mb-10 text-center text-[#FFFCFC]/90">Por qué elegirnos</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {PILLARS.map((pillar, index) => (
          <div class="p-6 md:p-8 rounded-[2rem] bg-[#FFFCFC]/5 backdrop-blur-xl border border-[#FFFCFC]/10 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.2)] hover:-translate-y-2 hover:bg-[#FFFCFC]/10 hover:border-blue-400/30 transition-all duration-300 cursor-default group">
            <h4 class="text-xl font-bold mb-4 text-[#FFFCFC] group-hover:text-blue-300 transition-colors">{pillar.title}</h4>
            <p class="text-[#FFFCFC]/70 text-sm leading-relaxed font-light">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
