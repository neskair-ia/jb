---
import { SERVICES, SERVICES_INTRO, SERVICES_INTRO_MOBILE, PILLARS } from '../config';

const serviceFiles = import.meta.glob('/public/servicios/*.{png,jpg,jpeg,webp,avif}');
const serviceImages: Record<string, string> = {};
Object.keys(serviceFiles).forEach(file => {
  const fileName = file.split('/').pop()?.split('.')[0];
  if (fileName) {
    serviceImages[fileName] = file.replace('/public', '');
  }
});
---

<section id="servicios" class="pt-28 pb-16 md:py-32 bg-transparent relative overflow-hidden">
  <div class="max-w-7xl mx-auto w-full px-4 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 text-[#FFFCFC]">
        Qué Hacemos
      </h2>
      <!-- Texto versión Desktop -->
      <p class="hidden md:block text-lg text-[#FFFCFC]/80 leading-relaxed font-light">
        {SERVICES_INTRO}
      </p>
      <!-- Texto versión Celular (Más corto y directo) -->
      <p class="md:hidden text-[15px] text-[#FFFCFC]/90 leading-relaxed px-2 font-medium">
        {SERVICES_INTRO_MOBILE}
      </p>
    </div>

    <!-- Catálogo de Servicios (Visual Principal) -->
    <div class="max-w-[95rem] mx-auto mb-20 md:mb-32">
      <!-- Grid de 3 columnas para destacar fotos -->
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-x-8 md:gap-y-16">
        {SERVICES.map((service, index) => (
          <div class="group cursor-default flex flex-col gap-5">
            
            <div class="relative w-full aspect-[4/5] rounded-2xl md:rounded-[2rem] overflow-hidden shadow-xl bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 transition-transform duration-500 group-hover:-translate-y-2 group-hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.5)]">
              <img 
                src={serviceImages[service.id.toString()] || `https://placehold.co/800x1000/0A1538/FFFCFC?text=${service.title.split(' ').join('+')}`} 
                alt={service.title} 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1E2D64]/90 via-[#1E2D64]/50 to-transparent opacity-90 group-hover:opacity-80 transition-opacity duration-500"></div>
              
              <!-- Contenido del servicio con gradiente suave pero sin difuminado (blur) -->
              <div class="absolute inset-x-0 bottom-0 p-4 md:p-8 pt-12 md:pt-24 flex flex-col justify-end bg-gradient-to-t from-[#1E2D64] via-[#1E2D64]/60 to-transparent transition-all duration-500 rounded-b-2xl md:rounded-b-[2rem]">
                <h4 class="text-base md:text-2xl font-bold text-[#FFFCFC] mb-2 md:mb-3 group-hover:text-blue-300 transition-colors leading-tight">{service.title}</h4>
                <p class="text-[#FFFCFC]/90 text-[11px] md:text-base leading-snug md:leading-relaxed line-clamp-3 lg:line-clamp-3 group-hover:line-clamp-none transition-all duration-500 hidden sm:block">
                  {service.description}
                </p>
              </div>
            </div>
            
          </div>
        ))}
      </div>
    </div>

    <!-- Pilares de Servicio (Secundario) -->
    <div class="max-w-7xl mx-auto border-t border-[#FFFCFC]/10 pt-16 md:pt-24">
      <h3 class="text-3xl md:text-5xl font-bold mb-12 md:mb-16 text-center text-[#FFFCFC] animate-on-scroll">Por qué elegirnos</h3>
      <div class="grid grid-cols-2 gap-2 sm:gap-4 md:gap-8">
        {PILLARS.map((pillar, index) => (
          <div class="animate-on-scroll" style={`transition-delay: ${index * 100}ms`}>
            <div class="h-full p-4 sm:p-6 md:p-12 rounded-2xl md:rounded-[2.5rem] bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 shadow-xl hover:-translate-y-2 hover:scale-[1.02] hover:bg-[#FFFCFC]/10 hover:border-[#FFFCFC]/30 transition-all duration-300 backdrop-blur-xl flex flex-col justify-center">
              <h3 class="text-[13px] sm:text-lg md:text-3xl font-bold mb-2 md:mb-5 text-[#FFFCFC] leading-tight">{pillar.title}</h3>
              <p class="text-blue-50 text-[10px] sm:text-sm md:text-lg leading-snug md:leading-relaxed font-light">{pillar.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
