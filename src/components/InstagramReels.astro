---
import { CONTACT } from '../config';

const instagramUrl = CONTACT.instagram;

const REELS = [
  {
    id: 1,
    title: "Corte Láser de Fibra Óptica",
    category: "Planta Industrial",
    tag: "Tecnología CNC",
    video: "/videos/innovacion.mp4",
    poster: "/infraestructura/7.webp",
  },
  {
    id: 2,
    title: "Plegado Hidráulico de Gran Tonelaje",
    category: "Procesos",
    tag: "Precisión",
    video: "/videos/eficiencia.mp4",
    poster: "/infraestructura/9.webp",
  },
  {
    id: 3,
    title: "Pintura Electrostática al Horno",
    category: "Terminación",
    tag: "Alta Resistencia",
    video: "/videos/excelencia.mp4",
    poster: "/infraestructura/13.webp",
  },
  {
    id: 4,
    title: "Montaje e Instalaciones en Obra",
    category: "Obras",
    tag: "Cobertura Nacional",
    video: "/videos/compromiso.mp4",
    poster: "/infraestructura/14.webp",
  },
  {
    id: 5,
    title: "Soldadura Certificada bajo Normas AWS",
    category: "Estructuras",
    tag: "Nivel 2",
    video: null,
    poster: "/infraestructura/6.webp",
  },
  {
    id: 6,
    title: "Mecanizados en Router CNC",
    category: "Desarrollos",
    tag: "Polímeros & Metales",
    video: null,
    poster: "/infraestructura/11.webp",
  }
];
---

<section id="instagram-reels" class="py-16 md:py-24 bg-gradient-to-b from-transparent via-[#0F172A]/40 to-transparent relative overflow-hidden border-t border-white/5">
  <!-- Brillo de fondo con colores de Instagram -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-purple-600/10 via-pink-600/10 to-amber-500/10 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <!-- Cabecera de la sección -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gradient-to-r from-purple-500/10 via-pink-500/10 to-orange-500/10 border border-pink-500/30 text-pink-300 text-xs sm:text-sm font-semibold mb-4 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-pink-500 animate-ping"></span>
          <span>Nuestras Redes</span>
        </div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-[#FFFCFC]">
          Seguinos en Instagram
        </h2>
        <p class="mt-3 text-base md:text-lg text-[#FFFCFC]/70 font-light leading-relaxed">
          Mirá el detrás de escena de nuestra planta, procesos de fabricación y el montaje de obras en todo el país a través de nuestros Reels.
        </p>
      </div>

      <!-- Botón de Acceso Directo Principal a Instagram -->
      <div class="flex items-center gap-3">
        <a 
          href={instagramUrl}
          target="_blank" 
          rel="noopener noreferrer"
          class="group/btn relative inline-flex items-center gap-3 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] text-white font-semibold text-sm md:text-base hover:shadow-[0_10px_30px_rgba(253,29,29,0.35)] hover:scale-105 transition-all duration-300 shrink-0"
          aria-label="Abrir Instagram de JB Ingeniería Corporativa"
        >
          <!-- Icono Instagram -->
          <svg class="w-5 h-5 fill-current transition-transform duration-300 group-hover/btn:rotate-6" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>@jbingenieriacorporativa</span>
          <!-- Flechita -->
          <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Contenedor del Carrusel con Botones de Navegación -->
    <div class="relative group/carousel">
      <!-- Botón Anterior -->
      <button 
        id="reels-prev-btn" 
        class="hidden md:flex absolute -left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-[#1E2D64]/90 backdrop-blur-md border border-white/20 items-center justify-center text-white shadow-xl hover:bg-pink-600 hover:border-pink-500 transition-all duration-300 hover:scale-110 active:scale-95"
        aria-label="Reel anterior"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Botón Siguiente -->
      <button 
        id="reels-next-btn" 
        class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-[#1E2D64]/90 backdrop-blur-md border border-white/20 items-center justify-center text-white shadow-xl hover:bg-pink-600 hover:border-pink-500 transition-all duration-300 hover:scale-110 active:scale-95"
        aria-label="Reel siguiente"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Track del Carrusel (Rotativo) -->
      <div 
        id="reels-carousel-track" 
        class="flex gap-4 sm:gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-6 pt-2 px-1 no-scrollbar cursor-grab active:cursor-grabbing"
      >
        {REELS.map((reel) => (
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="reel-card snap-start relative flex-shrink-0 w-[240px] sm:w-[270px] md:w-[300px] aspect-[9/16] rounded-[2rem] overflow-hidden bg-black/40 border border-white/10 shadow-[0_15px_35px_-10px_rgba(0,0,0,0.5)] group/card hover:border-pink-500/60 hover:shadow-[0_20px_45px_rgba(219,39,119,0.25)] transition-all duration-500 hover:-translate-y-2 select-none"
          >
            <!-- Media de Fondo: Video o Foto -->
            {reel.video ? (
              <video 
                src={reel.video} 
                poster={reel.poster}
                autoplay 
                muted 
                loop 
                playsinline 
                preload="metadata"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover/card:scale-110"
              />
            ) : (
              <img 
                src={reel.poster} 
                alt={reel.title} 
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover/card:scale-110" 
              />
            )}

            <!-- Degradados de protección para el texto -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F19] via-[#0B0F19]/30 to-black/40 opacity-90 transition-opacity duration-300 group-hover/card:opacity-75"></div>

            <!-- Header de la tarjeta del Reel -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/50 backdrop-blur-md border border-white/15 text-[11px] font-medium text-white/90">
                <span class="w-1.5 h-1.5 rounded-full bg-pink-500"></span>
                {reel.category}
              </span>

              <!-- Badge con Icono oficial de Reels -->
              <div class="w-8 h-8 rounded-full bg-black/50 backdrop-blur-md border border-white/15 flex items-center justify-center text-white shadow-md">
                <svg class="w-4 h-4 fill-current text-pink-400" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
                </svg>
              </div>
            </div>

            <!-- Botón de Play Central en Hover -->
            <div class="absolute inset-0 flex items-center justify-center z-10 pointer-events-none">
              <div class="w-14 h-14 rounded-full bg-pink-600/80 backdrop-blur-md border border-white/30 flex items-center justify-center text-white shadow-[0_0_20px_rgba(219,39,119,0.5)] transform scale-75 opacity-0 group-hover/card:opacity-100 group-hover/card:scale-100 transition-all duration-300">
                <svg class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>

            <!-- Footer de la tarjeta con Información -->
            <div class="absolute bottom-4 left-4 right-4 z-10">
              <!-- Tag de categoría -->
              <div class="mb-2">
                <span class="text-[10px] uppercase font-bold tracking-wider text-pink-400 bg-pink-950/60 px-2.5 py-0.5 rounded-md border border-pink-500/20">
                  {reel.tag}
                </span>
              </div>
              <h3 class="text-white text-sm sm:text-base font-bold leading-snug line-clamp-2 drop-shadow-md group-hover/card:text-pink-200 transition-colors">
                {reel.title}
              </h3>
              
              <!-- Enlace a Instagram -->
              <div class="mt-3 pt-3 border-t border-white/10 flex items-center justify-between text-xs text-white/80 font-medium group-hover/card:text-white">
                <span class="flex items-center gap-1.5 text-pink-300 group-hover/card:text-pink-200">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/>
                  </svg>
                  Ver Reel
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Barra de progreso / Indicador visual inferior -->
      <div class="mt-4 flex items-center justify-center gap-2">
        <span class="text-xs text-[#FFFCFC]/50 flex items-center gap-1.5 font-light">
          <svg class="w-3.5 h-3.5 animate-spin text-pink-400" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Rotación continua automática • Deslizá o hacé clic para ver en Instagram
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ocultar barra de scroll para navegación limpia */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  // Control de rotación automática y botones
  const track = document.getElementById('reels-carousel-track');
  const prevBtn = document.getElementById('reels-prev-btn');
  const nextBtn = document.getElementById('reels-next-btn');

  if (track) {
    let isHovered = false;
    const cardStep = 280; // Cantidad de scroll por paso

    const scrollNext = () => {
      if (!track) return;
      // Si llega al final, vuelve suavemente al inicio
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 20) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: cardStep, behavior: 'smooth' });
      }
    };

    const scrollPrev = () => {
      if (!track) return;
      if (track.scrollLeft <= 20) {
        track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: -cardStep, behavior: 'smooth' });
      }
    };

    // Auto-rotación cada 3.2 segundos
    let autoRotate = setInterval(() => {
      if (!isHovered) {
        scrollNext();
      }
    }, 3200);

    // Pausar rotación en hover o touch
    track.addEventListener('mouseenter', () => { isHovered = true; });
    track.addEventListener('mouseleave', () => { isHovered = false; });
    track.addEventListener('touchstart', () => { isHovered = true; }, { passive: true });
    track.addEventListener('touchend', () => { 
      setTimeout(() => { isHovered = false; }, 4000); 
    }, { passive: true });

    // Botones de control manual
    nextBtn?.addEventListener('click', () => {
      isHovered = true;
      scrollNext();
    });

    prevBtn?.addEventListener('click', () => {
      isHovered = true;
      scrollPrev();
    });
  }
</script>
