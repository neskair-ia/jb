---
// src/components/CustomCursor.astro
---
<div id="cursor-dot" class="fixed top-0 left-0 w-1.5 h-1.5 bg-white rounded-full pointer-events-none z-[10000] hidden lg:block" style="transform: translate3d(var(--x, 50vw), var(--y, 50vh), 0) translate(-50%, -50%);"></div>
<div id="cursor-ring" class="fixed top-0 left-0 w-7 h-7 border border-white/30 rounded-full pointer-events-none z-[9999] hidden lg:flex items-center justify-center transition-[width,height,background-color,border-color,backdrop-filter] duration-300 ease-out" style="transform: translate3d(var(--x, 50vw), var(--y, 50vh), 0) translate(-50%, -50%);">
  <span id="cursor-text" class="text-[8px] font-black text-[#1E2D64] opacity-0 transition-opacity duration-300 uppercase tracking-widest whitespace-nowrap"></span>
</div>

<style is:global>
  /* Solo aplicamos en desktop con mouse */
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    /* Ocultar el cursor por defecto del sistema */
    body, a, button, input, textarea, select, label, .cursor-pointer {
      cursor: none !important;
    }
    
    #cursor-dot, #cursor-ring {
      display: flex;
    }
    
    /* Transiciones suaves en el dot (opacidad y escala por separado del translate) */
    #cursor-dot {
      transition: opacity 0.3s, width 0.3s, height 0.3s;
    }

    /* ESTADO: HOVER NORMAL (Botones, Links) */
    body.cursor-hover #cursor-ring {
      width: 36px;
      height: 36px;
      background-color: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.6);
    }
    body.cursor-hover #cursor-dot {
      opacity: 0.2;
      width: 3px;
      height: 3px;
    }
    
    /* ESTADO: VER PROYECTO (Tarjetas de galería) */
    body.cursor-view #cursor-ring {
      width: 50px;
      height: 50px;
      background-color: rgba(255, 255, 255, 0.95);
      border-color: rgba(255, 255, 255, 1);
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }
    body.cursor-view #cursor-dot {
      opacity: 0;
    }
    body.cursor-view #cursor-text {
      opacity: 1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Verificar si es desktop con mouse
    if (window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches) {
      const dot = document.getElementById('cursor-dot');
      const ring = document.getElementById('cursor-ring');
      const text = document.getElementById('cursor-text');
      
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      let ringX = mouseX;
      let ringY = mouseY;
      
      // Manejar la visibilidad cuando el cursor entra o sale de la ventana
      document.addEventListener('mouseleave', () => {
        if(dot) dot.style.opacity = '0';
        if(ring) ring.style.opacity = '0';
      });
      document.addEventListener('mouseenter', () => {
        if(dot) dot.style.opacity = '1';
        if(ring) ring.style.opacity = '1';
      });

      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        
        // Mover el punto principal instantáneamente con variables CSS
        if (dot) {
          dot.style.setProperty('--x', `${mouseX}px`);
          dot.style.setProperty('--y', `${mouseY}px`);
        }
      });
      
      // Animación suave para el anillo usando requestAnimationFrame
      const render = () => {
        ringX += (mouseX - ringX) * 0.15; // Velocidad de seguimiento (0.15 es suave y responsivo)
        ringY += (mouseY - ringY) * 0.15;
        
        if (ring) {
          ring.style.setProperty('--x', `${ringX}px`);
          ring.style.setProperty('--y', `${ringY}px`);
        }
        
        requestAnimationFrame(render);
      };
      requestAnimationFrame(render);
      
      // Configurar eventos hover para interactuar con botones y links
      const setupHoverStates = () => {
        // Elementos normales clickeables
        const hoverElements = document.querySelectorAll('a, button, label, .secure-contact-btn');
        // Elementos especiales de proyecto
        const viewElements = document.querySelectorAll('.project-card');
        
        hoverElements.forEach(el => {
          // Evitar registrar múltiples veces
          if (!el.hasAttribute('data-cursor-bound')) {
            el.setAttribute('data-cursor-bound', 'true');
            el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
            el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
          }
        });
        
        viewElements.forEach(el => {
          if (!el.hasAttribute('data-cursor-bound')) {
            el.setAttribute('data-cursor-bound', 'true');
            el.addEventListener('mouseenter', () => {
              document.body.classList.add('cursor-view');
              if (text) text.textContent = 'VER';
            });
            el.addEventListener('mouseleave', () => {
              document.body.classList.remove('cursor-view');
              if (text) text.textContent = '';
            });
          }
        });
      };
      
      setupHoverStates();
      
      // Usar MutationObserver por si se carga contenido dinámico
      const observer = new MutationObserver(() => {
        setupHoverStates();
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  });
</script>
