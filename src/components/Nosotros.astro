---
import { ABOUT } from '../config';
---

<section id="nosotros" class="pt-28 pb-16 md:py-32 bg-transparent relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-7xl mx-auto w-full">
      
      <!-- Quiénes Somos -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center mb-16 md:mb-24">
        <!-- Imagen -->
        <div class="order-2 lg:order-1 relative rounded-[2.5rem] overflow-hidden shadow-2xl border border-[#FFFCFC]/10 aspect-[3/4] lg:aspect-auto lg:h-[650px] group">
          <img src="/images/quienes-somos.png" alt="Instalaciones JB Ingeniería" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" onerror="this.src='https://placehold.co/600x800/1E2D64/FFFCFC?text=Foto+JB'" />
          <!-- Sutil gradiente oscuro para que la foto tenga peso -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#1E2D64]/80 via-transparent to-transparent opacity-80"></div>
        </div>
        
        <!-- Texto -->
        <div class="order-1 lg:order-2 text-left">
          <div class="inline-block px-4 py-1.5 rounded-full bg-[#FFFCFC]/10 border border-[#FFFCFC]/20 text-blue-300 text-sm font-semibold mb-6 backdrop-blur-md">
            Nuestra Historia
          </div>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-8 text-[#FFFCFC]">
            Quiénes Somos
          </h2>
          <div class="text-[1.1rem] md:text-[1.25rem] text-[#FFFCFC]/80 leading-loose font-light relative">
            <input type="checkbox" id="about-read-more-mobile" class="peer hidden" />
            
            <div class="line-clamp-6 md:line-clamp-none peer-checked:line-clamp-none transition-all duration-300">
              {ABOUT.whoWeAre.split('\n').map(paragraph => (
                <p set:html={paragraph} class="mb-6 last:mb-0" />
              ))}
            </div>
            
            <div class="mt-4 flex md:hidden peer-checked:hidden">
              <label for="about-read-more-mobile" class="inline-flex items-center justify-center px-4 py-2 rounded-full border border-blue-400 text-blue-400 text-sm cursor-pointer font-bold hover:bg-blue-400 hover:text-[#1E2D64] transition-colors select-none shadow-[0_0_10px_rgba(96,165,250,0.1)]">
                Seguir leyendo
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Misión y Visión -->
      <div class="grid grid-cols-2 gap-2 sm:gap-4 md:gap-8 mb-16 md:mb-20">
        <!-- Card Misión -->
        <div class="animate-on-scroll p-4 sm:p-6 md:p-12 rounded-2xl md:rounded-[2.5rem] bg-[#FFFCFC]/5 backdrop-blur-xl border border-[#FFFCFC]/10 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.5)] hover:scale-[1.02] hover:bg-[#FFFCFC]/10 hover:border-[#FFFCFC]/30 transition-all duration-300 h-full flex flex-col">
          <h3 class="text-xl sm:text-2xl md:text-4xl font-bold mb-3 sm:mb-6 tracking-tight text-[#FFFCFC]">Nuestra Misión</h3>
          <div class="flex-1">
            <p class="text-[#FFFCFC]/80 text-xs sm:text-sm md:text-lg leading-relaxed font-light">
              {ABOUT.mission}
            </p>
          </div>
        </div>

        <!-- Card Visión -->
        <div class="animate-on-scroll p-4 sm:p-6 md:p-12 rounded-2xl md:rounded-[2.5rem] bg-[#FFFCFC]/5 backdrop-blur-xl border border-[#FFFCFC]/10 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.5)] hover:scale-[1.02] hover:bg-[#FFFCFC]/10 hover:border-[#FFFCFC]/30 transition-all duration-300 h-full flex flex-col">
          <h3 class="text-xl sm:text-2xl md:text-4xl font-bold mb-3 sm:mb-6 tracking-tight text-[#FFFCFC]">Nuestra Visión</h3>
          <div class="flex-1">
            <p class="text-[#FFFCFC]/80 text-xs sm:text-sm md:text-lg leading-relaxed font-light">
              {ABOUT.vision}
            </p>
          </div>
        </div>
      </div>

      <!-- Valores -->
      <div class="animate-on-scroll">
        <h3 class="text-2xl md:text-4xl font-bold mb-8 md:mb-12 text-center text-[#FFFCFC]">Nuestros Valores</h3>
        <div class="grid grid-cols-2 gap-2 sm:gap-4 md:gap-8">
          {ABOUT.values.map((value, index) => (
            <div class="p-3 sm:p-6 md:p-10 rounded-2xl sm:rounded-[2rem] bg-[#FFFCFC]/5 backdrop-blur-xl border border-[#FFFCFC]/10 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.5)] hover:scale-[1.02] hover:bg-[#FFFCFC]/10 hover:border-[#FFFCFC]/30 transition-all duration-300 flex flex-col xl:flex-row gap-3 sm:gap-5 md:gap-8 items-stretch h-full">
              
              <!-- Text Content -->
              <div class="flex-1 flex flex-col">
                <div class="p-4 sm:p-6 md:p-8 rounded-xl sm:rounded-2xl md:rounded-[2rem] bg-[#FFFCFC]/5 border border-[#FFFCFC]/10 h-full flex flex-col relative">
                  <h4 class="text-sm sm:text-lg md:text-2xl font-bold mb-2 sm:mb-4 text-[#FFFCFC] flex flex-col xl:flex-row items-start xl:items-center gap-2 sm:gap-3">
                    <span class="w-6 h-6 sm:w-8 sm:h-8 md:w-10 md:h-10 rounded-full bg-blue-600 flex items-center justify-center text-[10px] sm:text-sm md:text-base shrink-0 text-white">
                      {index + 1}
                    </span>
                    {value.title}
                  </h4>
                  
                  <input type="checkbox" id={`value-read-more-${index}`} class="peer hidden" />
                  <div class="text-[#FFFCFC]/80 text-[10px] sm:text-xs md:text-base leading-relaxed xl:pl-14 line-clamp-3 peer-checked:line-clamp-none transition-all duration-300">
                    <p>{value.description}</p>
                  </div>
                  <div class="mt-2 sm:mt-4 xl:pl-14 flex peer-checked:hidden">
                    <label for={`value-read-more-${index}`} class="inline-flex items-center justify-center px-3 py-1.5 sm:px-4 sm:py-2 rounded-full border border-blue-400/50 hover:bg-blue-400 hover:text-[#1E2D64] hover:border-blue-400 text-blue-300 text-[9px] sm:text-xs md:text-sm cursor-pointer font-bold transition-all select-none">
                      Seguir leyendo
                    </label>
                  </div>
                </div>
              </div>

              <!-- Video Placeholder -->
              <div class="w-full xl:w-48 h-40 xl:h-auto bg-black/20 rounded-[1.5rem] border border-[#FFFCFC]/10 flex flex-col items-center justify-center gap-3 relative overflow-hidden shrink-0 shadow-inner">
                <svg class="w-10 h-10 md:w-12 md:h-12 text-[#FFFCFC]/30 drop-shadow-md" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
                <span class="text-xs uppercase tracking-widest font-bold text-[#FFFCFC]/30 drop-shadow-md">Video Reel</span>
              </div>

            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
