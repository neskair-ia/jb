---
import { ABOUT } from '../config';
---

<section id="nosotros" class="py-24 bg-white relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto">
      
      <!-- Quiénes Somos -->
      <div class="text-center mb-20 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-8 text-[#0e2146]">
          Quiénes Somos
        </h2>
        <div class="text-lg md:text-xl text-slate-600 leading-relaxed space-y-6 text-left p-8 md:p-12 rounded-[2rem] bg-white border border-slate-100 shadow-[0_20px_60px_-15px_rgba(14,33,70,0.05)] backdrop-blur-xl">
          {ABOUT.whoWeAre.split('\n').map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <!-- Misión y Visión -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        <div class="animate-on-scroll p-8 rounded-3xl bg-gradient-to-br from-[#0e2146] to-blue-900 text-white shadow-xl">
          <div class="w-12 h-12 bg-white/10 rounded-2xl flex items-center justify-center mb-6 backdrop-blur-sm">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Nuestra Misión</h3>
          <p class="text-blue-100 leading-relaxed font-light">
            {ABOUT.mission}
          </p>
        </div>

        <div class="animate-on-scroll p-8 rounded-3xl bg-white border border-[#0e2146]/10 shadow-[0_20px_60px_-15px_rgba(14,33,70,0.05)]">
          <div class="w-12 h-12 bg-[#0e2146]/5 rounded-2xl flex items-center justify-center mb-6 text-[#0e2146]">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 text-[#0e2146]">Nuestra Visión</h3>
          <p class="text-slate-600 leading-relaxed">
            {ABOUT.vision}
          </p>
        </div>
      </div>

      <!-- Valores -->
      <div class="animate-on-scroll">
        <h3 class="text-3xl font-bold mb-10 text-center text-[#0e2146]">Nuestros Valores</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {ABOUT.values.map((value, index) => (
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:border-[#0e2146]/20 hover:shadow-lg transition-all duration-300">
              <h4 class="text-xl font-bold mb-3 text-[#0e2146] flex items-center gap-2">
                <span class="w-8 h-8 rounded-full bg-[#0e2146]/10 flex items-center justify-center text-sm">
                  {index + 1}
                </span>
                {value.title}
              </h4>
              <p class="text-slate-600 text-sm leading-relaxed pl-10">
                {value.description}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
